# ==========================================================
# GENERIC LINK -> RELATIONSHIP EXTRACTION
# One link = one LLM call. Checkpointed, resumable, concurrent.
#
# Nothing environment-specific is hardcoded: endpoint, model,
# tables, column names, link markup, prompt wording, predicate
# rules and concurrency are all driven by ExtractionConfig /
# ColumnMap (see the usage example at the bottom).
# ==========================================================

import math
import re
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from typing import Callable, List, Optional, Tuple


# ----------------------------------------------------------
# 1. CONFIG
# ----------------------------------------------------------

LINK_FIELDS = (
    "link_uid", "source_node", "source_title", "occurrence",
    "target_reference", "target_title", "link_type", "sentence",
)

OUT_COLUMNS = [
    "link_uid", "source_node", "source_title", "predicate",
    "relationship_description", "relationship_strength",
    "target_title", "target_reference", "link_type", "context_used",
]


@dataclass
class ColumnMap:
    """Map YOUR column names -> the canonical names used internally."""
    # links dataframe
    link_uid: str = "link_uid"
    source_node: str = "source_node"
    source_title: str = "source_title"
    occurrence: str = "occurrence"          # index of the link within its doc
    target_reference: str = "target_reference"
    target_title: str = "target_title"
    link_type: str = "link_type"
    sentence: str = "sentence"              # fallback context if no occurrence
    # documents dataframe (joined to links on `source_node`)
    doc_text: str = "doc_text"


@dataclass
class ExtractionConfig:
    # ---- required ----
    model: str
    base_url: str                 # any OpenAI-compatible endpoint
    api_key: str
    checkpoint_table: str         # catalog.schema.table (append-only)

    # ---- LLM ----
    temperature: Optional[float] = 0.0   # None = don't send (some models reject it)
    timeout: int = 120
    max_retries: int = 3
    # Optional: bring your own client. Called as llm_factory(cfg); the returned
    # object must expose .invoke(messages) -> object with .content
    llm_factory: Optional[Callable] = None

    # ---- which links to process ----
    link_filter: Optional[str] = None            # SQL expr on ORIGINAL columns, e.g. "is_resolved"
    ignore_link_types: Tuple[str, ...] = ()

    # ---- context window around the link ----
    window_words: int = 6
    skip_symbol_tokens: bool = True              # bullets/pipes/dashes don't use up the word budget
    skip_links_without_context: bool = False     # skip links where only "<Title>" is available
    # Link markup. Must define named groups `label` and/or `title`.
    link_pattern: str = (
        r"\[(?:(?P<label>[^<>\[\]]+?)\s+)?<doc:(?:wiki:)?[^>]+>\]"
        r"|<(?P<title>[^<>]+)>"
    )
    unresolved_markup_pattern: str = r"\[?<doc:(?:wiki:)?[^<>]+>\]?"

    # ---- prompt / output format ----
    system_prompt: Optional[str] = None          # full override; else built from fields below
    user_prompt_template: str = "SOURCE: {source}\n\nTARGET: {target}\n\nTEXT:\n{text}"
    source_label: str = "source document"
    target_label: str = "linked entity"
    tuple_delim: str = "<|>"
    record_delim: str = "##"
    banned_predicates: Tuple[str, ...] = ("related_to", "mentions", "references", "has_link")
    allowed_predicates: Optional[Tuple[str, ...]] = None   # controlled vocabulary (optional)
    predicate_min_words: int = 2
    predicate_max_words: int = 5
    max_description_words: int = 25
    strength_min: int = 1
    strength_max: int = 10

    # ---- execution ----
    n_partitions: int = 1
    max_workers: int = 8                         # concurrent LLM calls per partition
    docs_per_chunk: int = 200                    # a chunk is written atomically -> keep small
    max_error_rate: float = 0.2                  # abort partition if exceeded...
    min_calls_for_error_check: int = 20          # ...after at least this many calls


_SENT_OPEN, _SENT_CLOSE = "\ue000", "\ue001"
_SENTINEL_RE = re.compile(_SENT_OPEN + r"(\d+)" + _SENT_CLOSE)


# ----------------------------------------------------------
# 2. PROMPT
# ----------------------------------------------------------

def build_system_prompt(cfg: ExtractionConfig) -> str:
    if cfg.system_prompt:
        return cfg.system_prompt

    d = cfg.tuple_delim
    lines = [
        "You label ONE relationship for a knowledge graph.",
        "",
        f"SOURCE = the {cfg.source_label}.",
        f"TARGET = the {cfg.target_label}.",
        "TEXT = short context around the TARGET. The TARGET appears in TEXT "
        "wrapped in <angle brackets>. '...' means the text was truncated.",
        "",
        "The graph edge is:  SOURCE --predicate--> TARGET",
        "Choose a specific predicate that makes this a TRUE natural statement.",
        "",
        "Return exactly one line:",
        f"PREDICATE{d}DESCRIPTION{d}STRENGTH{cfg.record_delim}",
        "",
        "PREDICATE:",
        f"- snake_case, {cfg.predicate_min_words}-{cfg.predicate_max_words} words",
        "- a specific relationship",
        f"- NEVER use: {', '.join(cfg.banned_predicates)}",
    ]
    if cfg.allowed_predicates:
        lines.append("- MUST be exactly one of: " + ", ".join(cfg.allowed_predicates))
    lines += [
        "",
        "DESCRIPTION:",
        f"- one complete sentence, maximum {cfg.max_description_words} words",
        "",
        "STRENGTH:",
        f"- integer {cfg.strength_min}-{cfg.strength_max}",
        f"- {cfg.strength_max} = explicit/central, {cfg.strength_min} = passing mention",
        "",
        "No JSON. No markdown. No extra text.",
    ]
    return "\n".join(lines)


# ----------------------------------------------------------
# 3. CONTEXT BUILDER
# ----------------------------------------------------------

class ContextBuilder:
    def __init__(self, cfg: ExtractionConfig):
        self.cfg = cfg
        self.link_re = re.compile(cfg.link_pattern)
        self.unresolved_re = re.compile(cfg.unresolved_markup_pattern)

    def _sanitize(self, text):
        return re.sub(r"\s+", " ", self.unresolved_re.sub(" ", text or "")).strip()

    def _tokenize(self, text):
        display = []

        def repl(m):
            groups = m.groupdict()
            title = groups.get("title")
            display.append(title if title is not None else (groups.get("label") or ""))
            return f"{_SENT_OPEN}{len(display) - 1}{_SENT_CLOSE}"

        return self.link_re.sub(repl, text or "").split(), display

    @staticmethod
    def _render(words, display, target):
        def sub(m):
            k = int(m.group(1))
            return f"<{display[k]}>" if k == target else display[k]

        return re.sub(
            r"\s+", " ", " ".join(_SENTINEL_RE.sub(sub, w) for w in words)
        ).strip()

    def _counts(self, token):
        return (not self.cfg.skip_symbol_tokens) or bool(re.search(r"\w", token))

    def _bounds(self, words, i):
        """Hard-capped window: at most `window_words` counted words per side."""
        n = self.cfg.window_words
        lo, seen = i, 0
        while lo > 0 and seen < n:
            lo -= 1
            seen += self._counts(words[lo])
        hi, seen = i + 1, 0
        while hi < len(words) and seen < n:
            seen += self._counts(words[hi])
            hi += 1
        return lo, hi

    def _fallback(self, sentence, title):
        s = self._sanitize(sentence)
        marker = f"<{title}>"
        k = s.find(marker)
        if k < 0:
            return marker
        n = self.cfg.window_words
        before = s[:k].split()[-n:] if n else []
        after = s[k + len(marker):].split()[:n]
        return " ".join(before + [marker] + after)

    def contexts_for_doc(self, doc_text, items) -> List[str]:
        words, display = self._tokenize(doc_text)

        positions = {}
        for i, w in enumerate(words):
            for m in _SENTINEL_RE.finditer(w):
                positions.setdefault(int(m.group(1)), i)

        out = []
        for item in items:
            occ, title = item["occurrence"], item["target_title"]
            if occ is None or occ not in positions or display[occ] != title:
                out.append(self._fallback(item["sentence"], title))
                continue
            lo, hi = self._bounds(words, positions[occ])
            text = self._render(words[lo:hi], display, occ)
            if lo > 0:
                text = "... " + text
            if hi < len(words):
                text += " ..."
            out.append(text)
        return out


# ----------------------------------------------------------
# 4. RESPONSE PARSER  (strict: bad output is rejected, not guessed)
# ----------------------------------------------------------

class RelationshipParser:
    def __init__(self, cfg: ExtractionConfig):
        self.cfg = cfg
        self.banned = {b.lower() for b in cfg.banned_predicates}
        self.allowed = (
            {a.lower() for a in cfg.allowed_predicates} if cfg.allowed_predicates else None
        )

    @staticmethod
    def to_snake_case(s):
        return re.sub(r"_+", "_", re.sub(r"[^a-z0-9]+", "_", (s or "").strip().lower())).strip("_")

    def parse(self, text) -> Optional[Tuple[str, str, int]]:
        cfg = self.cfg
        parts = [
            p.strip()
            for p in (text or "").split(cfg.record_delim)[0].strip().split(cfg.tuple_delim)
        ]
        # tolerate a stray leading record index ("1<|>pred<|>desc<|>7")
        if len(parts) >= 4 and parts[0].isdigit():
            parts = parts[1:]
        if len(parts) < 3:
            return None

        predicate = self.to_snake_case(parts[0])
        description = cfg.tuple_delim.join(parts[1:-1]).strip()
        m = re.search(r"\d+", parts[-1])

        if not predicate or not description or not m:
            return None
        if predicate in self.banned:
            return None
        if not (cfg.predicate_min_words <= len(predicate.split("_")) <= cfg.predicate_max_words):
            return None
        if self.allowed is not None and predicate not in self.allowed:
            return None

        strength = max(cfg.strength_min, min(cfg.strength_max, int(m.group())))
        return predicate, description, strength


# ----------------------------------------------------------
# 5. WORKER  (runs on executors via mapInPandas)
# ----------------------------------------------------------

def _build_llm(cfg: ExtractionConfig):
    if cfg.llm_factory is not None:
        return cfg.llm_factory(cfg)
    from langchain_openai import ChatOpenAI

    kwargs = dict(
        model=cfg.model,
        base_url=cfg.base_url,
        api_key=cfg.api_key,
        max_retries=cfg.max_retries,
        timeout=cfg.timeout,
    )
    if cfg.temperature is not None:
        kwargs["temperature"] = cfg.temperature
    return ChatOpenAI(**kwargs)


def make_partition_fn(cfg: ExtractionConfig):
    """Returns the function handed to mapInPandas (cfg is captured in the closure)."""

    def process(pdf_iterator):
        import pandas as pd

        llm = _build_llm(cfg)
        ctx = ContextBuilder(cfg)
        parser = RelationshipParser(cfg)
        system_prompt = build_system_prompt(cfg)

        n_total = n_err = n_parse_fail = 0
        last_err = None

        def call(job):
            source_node, source_title, item, context = job
            user = cfg.user_prompt_template.format(
                source=source_title, target=item["target_title"], text=context
            )
            try:
                resp = llm.invoke([
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": user},
                ])
                content = resp.content if isinstance(resp.content, str) else str(resp.content)
                return job, parser.parse(content), None
            except Exception as e:  # noqa: BLE001 - counted and surfaced below
                return job, None, repr(e)

        with ThreadPoolExecutor(max_workers=max(1, cfg.max_workers)) as pool:
            for pdf in pdf_iterator:
                jobs = []
                for _, row in pdf.iterrows():
                    items = list(row["items"])
                    contexts = ctx.contexts_for_doc(row["doc_text"], items)
                    for item, context in zip(items, contexts):
                        if (
                            cfg.skip_links_without_context
                            and context.strip() == f"<{item['target_title']}>"
                        ):
                            continue  # not checkpointed; costs nothing to re-skip
                        jobs.append((row["source_node"], row["source_title"], item, context))

                results = []
                for job, parsed, err in pool.map(call, jobs):
                    n_total += 1
                    if err is not None:
                        n_err += 1
                        last_err = err
                        continue
                    if parsed is None:
                        n_parse_fail += 1
                        continue
                    source_node, source_title, item, context = job
                    predicate, description, strength = parsed
                    results.append({
                        "link_uid": item["link_uid"],
                        "source_node": source_node,
                        "source_title": source_title,
                        "predicate": predicate,
                        "relationship_description": description,
                        "relationship_strength": strength,
                        "target_title": item["target_title"],
                        "target_reference": item["target_reference"],
                        "link_type": item["link_type"],
                        "context_used": context,
                    })

                # Fail loudly instead of "completing" with nothing written.
                if (
                    n_total >= cfg.min_calls_for_error_check
                    and n_err / n_total > cfg.max_error_rate
                ):
                    raise RuntimeError(
                        f"LLM error rate {n_err}/{n_total} exceeds "
                        f"{cfg.max_error_rate:.0%}. Last error: {last_err}"
                    )

                # Failed / unparseable links are simply NOT written, so the
                # checkpoint anti-join retries them on the next run.
                yield pd.DataFrame(results, columns=OUT_COLUMNS)

        if n_parse_fail:
            print(f"[partition] unparseable LLM responses: {n_parse_fail}/{n_total}")

    return process


# ----------------------------------------------------------
# 6. ORCHESTRATION
# ----------------------------------------------------------

def _out_schema():
    from pyspark.sql.types import IntegerType, StringType, StructField, StructType

    return StructType([
        StructField(n, IntegerType() if n == "relationship_strength" else StringType())
        for n in OUT_COLUMNS
    ])


def run_relationship_extraction(
    spark,
    links_df,
    docs_df,
    cfg: ExtractionConfig,
    columns: Optional[ColumnMap] = None,
    dry_run: bool = False,
):
    """
    links_df : one row per link (see ColumnMap for expected columns)
    docs_df  : one row per source document (source_node + doc_text)
    Returns the checkpoint table as a DataFrame (or None if it doesn't exist).
    """
    from pyspark.sql import functions as F

    cm = columns or ColumnMap()

    # ---- select + normalise input ----
    links = links_df.filter(cfg.link_filter) if cfg.link_filter else links_df
    links = links.select(*[F.col(getattr(cm, k)).alias(k) for k in LINK_FIELDS])

    if cfg.ignore_link_types:
        # coalesce: NULL link_type must not be silently dropped by NOT IN
        links = links.filter(
            ~F.coalesce(F.col("link_type"), F.lit("")).isin(list(cfg.ignore_link_types))
        )
    links = links.dropDuplicates(["link_uid"])

    docs = (
        docs_df
        .select(
            F.col(cm.source_node).alias("source_node"),
            F.col(cm.doc_text).alias("doc_text"),
        )
        .dropDuplicates(["source_node"])
    )

    # ---- checkpoint: skip links that are already done ----
    if spark.catalog.tableExists(cfg.checkpoint_table):
        done = spark.table(cfg.checkpoint_table).select("link_uid").distinct()
        links = links.join(done, on="link_uid", how="left_anti")

    n_links_todo = links.count()
    print(f"Links remaining: {n_links_todo}")

    # ---- one row per document, carrying all its links ----
    doc_batches = (
        links.groupBy("source_node", "source_title")
        .agg(
            F.collect_list(
                F.struct(
                    "link_uid", "occurrence", "target_title",
                    "target_reference", "link_type", "sentence",
                )
            ).alias("items")
        )
        .join(docs, on="source_node", how="inner")
    )

    # ---- run ----
    if n_links_todo > 0 and not dry_run:
        n_docs = doc_batches.count()
        n_chunks = max(1, math.ceil(n_docs / cfg.docs_per_chunk))
        doc_batches = doc_batches.withColumn(
            "_chunk", F.pmod(F.xxhash64("source_node"), F.lit(n_chunks))
        )
        fn = make_partition_fn(cfg)
        schema = _out_schema()

        for c in range(n_chunks):
            (
                doc_batches.filter(F.col("_chunk") == c)
                .drop("_chunk")
                .repartition(cfg.n_partitions)
                .mapInPandas(fn, schema=schema)
                .write.mode("append")
                .option("mergeSchema", "true")
                .saveAsTable(cfg.checkpoint_table)
            )
            print(f"Chunk {c + 1}/{n_chunks} written.")
        print("LLM extraction completed.")

    return spark.table(cfg.checkpoint_table) if spark.catalog.tableExists(cfg.checkpoint_table) else None


