# ==========================================================
# 22. RESOLVE UPSTREAM DATAFRAMES
#
# THIS FIXES:
#
# NameError: name 'sentences_df' is not defined
#
# We first use the expected names.
#
# If those names are not defined, we look for another
# Spark DataFrame already created in the notebook that has
# the required columns.
# ==========================================================

def _find_existing_dataframe(
    preferred_name,
    required_columns
):

    # ------------------------------------------------------
    # First: exact expected variable name
    # ------------------------------------------------------

    candidate = globals().get(
        preferred_name
    )

    if candidate is not None:

        try:

            columns = set(
                candidate.columns
            )

            if set(
                required_columns
            ).issubset(columns):

                return candidate

        except Exception:

            pass


    # ------------------------------------------------------
    # Second: search existing notebook variables
    # ------------------------------------------------------

    for name, obj in list(
        globals().items()
    ):

        if name.startswith("_"):

            continue

        try:

            if not hasattr(
                obj,
                "columns"
            ):

                continue

            columns = set(
                obj.columns
            )

            if set(
                required_columns
            ).issubset(columns):

                print(
                    f"Using existing DataFrame "
                    f"'{name}' for '{preferred_name}'."
                )

                return obj

        except Exception:

            continue


    # ------------------------------------------------------
    # Nothing found
    # ------------------------------------------------------

    return None


# ==========================================================
# 23. FIND SENTENCES DATAFRAME
# ==========================================================

print()
print("=" * 80)
