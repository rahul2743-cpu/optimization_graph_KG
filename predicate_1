# ==========================================================
# Cell 10b : LLM RELATIONSHIP EXTRACTION -- RUN  (part 2 of 2)
#
#   Requires Cell 10a to have been run in this session.
#   Needs: sentences_df (Cell 8b)
#
#   What this cell does:
#     1  one work item per (document, target): the FIRST occurrence's
#        sentence + how many times the target is linked
#     2  retry failed targets, skip finished ones (resume)
#     3  run the LLM extraction in chunks, saving after each chunk
#     4  expose `triples_df` (usable rows only) for Cell 11
#
#   This is the cell that makes LLM calls. Re-running it resumes
#   where the last run stopped.
#
#   OUTPUT FOR THE REST OF THE NOTEBOOK:
#     triples_df      status == 'ok' rows only  -> Cell 11 / 12 (graph)
#     triples_all_df  every row incl. failed / parse_error (diagnostics)
#   Failed rows never enter the graph as fake "related_to" edges.
# ==========================================================
from pyspark.sql import functions as F
from pyspark.sql.window import Window

_required = [
    "process_partition_pandas", "TRIPLES_SCHEMA", "CHECKPOINT_TABLE",
    "N_PARTITIONS", "CHUNK_TARGETS", "RETRY_FAILED", "TARGET_PLACEHOLDER",
]

_missing = [n for n in _required if n not in globals()]

if _missing:
    raise RuntimeError(f"Run Cell 10a first. Missing definitions: {_missing}")

if "sentences_df" not in globals():
    raise RuntimeError("sentences_df not found. Run Cell 8b first.")

print("=" * 80)
print("CELL 10b — RUN LLM RELATIONSHIP EXTRACTION")
print("=" * 80)


# ==========================================================
# 1. ONE WORK ITEM PER (DOCUMENT, TARGET)
#
# sentences_df has one row per link OCCURRENCE. A target linked
# several times in a document is extracted ONCE, from its first
# occurrence, and the link count is passed to the LLM.
# ==========================================================

KEY_COLS = ["source_node", "target_reference"]

resolved_occurrences = sentences_df.filter(F.col("is_resolved"))

w_key = Window.partitionBy(*KEY_COLS)

targets_all = (
    resolved_occurrences
    .filter(F.col("sentence_masked").contains(TARGET_PLACEHOLDER))
    .withColumn("mention_count", F.count(F.lit(1)).over(w_key).cast("int"))
    .withColumn(
        "_rk",
        F.row_number().over(w_key.orderBy(F.col("occurrence").asc()))
    )
    .filter(F.col("_rk") == 1)
    .select(
        "source_node",
        "source_title",
        "target_reference",
        "target_title",
        "link_type",
        "sentence_masked",
        "mention_count",
    )
)

n_occurrences = resolved_occurrences.count()
n_pairs_resolved = resolved_occurrences.select(*KEY_COLS).distinct().count()
n_targets_total = targets_all.count()

print(f"Resolved link occurrences (Cell 8b)        : {n_occurrences}")
print(f"Distinct (document, target) pairs          : {n_pairs_resolved}")
print(f"Targets with a locatable sentence          : {n_targets_total}")

if n_targets_total < n_pairs_resolved:
    print(
        f"WARNING: {n_pairs_resolved - n_targets_total} targets have no "
        f"placeholder in sentence_masked and are skipped (check Cell 8b)."
    )


# ==========================================================
# 2. CHECKPOINT: RETRY FAILED TARGETS, SKIP FINISHED ONES
#
# The checkpoint key is (source_node, target_reference), so a
# crash or a failure only ever costs the affected targets.
# ==========================================================

targets = targets_all

table_exists = spark.catalog.tableExists(CHECKPOINT_TABLE)

if table_exists:

    existing_cols = spark.table(CHECKPOINT_TABLE).columns

    failed_sql_parts = [
        "relationship_description LIKE '[extraction failed%'"
    ]

    if "status" in existing_cols:
        failed_sql_parts.append("status = 'failed'")

    failed_sql = " OR ".join(failed_sql_parts)

    n_failed_rows = spark.sql(
        f"SELECT COUNT(*) AS n FROM {CHECKPOINT_TABLE} WHERE {failed_sql}"
    ).first()["n"]

    if n_failed_rows and RETRY_FAILED:

        spark.sql(
            f"DELETE FROM {CHECKPOINT_TABLE} WHERE {failed_sql}"
        )

        print(f"Failed targets deleted, queued for retry    : {n_failed_rows}")

    elif n_failed_rows:

        print(
            f"WARNING: {n_failed_rows} failed rows in the checkpoint "
            f"(RETRY_FAILED=False, they will not be retried)."
        )

    already_done = (
        spark.table(CHECKPOINT_TABLE)
        .select(*KEY_COLS)
        .distinct()
    )

    n_already_done = already_done.count()

    targets = targets.join(already_done, on=KEY_COLS, how="left_anti")

    print(f"Already checkpointed (skipped)              : {n_already_done} targets")

else:

    print(
        "No existing checkpoint table found -- "
        f"starting fresh at {CHECKPOINT_TABLE}"
    )

n_to_process = targets.count()

print(f"Targets to process this run                 : {n_to_process}")


# ==========================================================
# 3. RUN DISTRIBUTED EXTRACTION IN CHUNKS
#
# Each chunk is appended to the checkpoint table as soon as it
# finishes, so a crash only loses the chunk in progress.
# ==========================================================

if n_to_process == 0:

    print("Nothing to do -- all targets already checkpointed.")

else:

    rows_before = (
        spark.table(CHECKPOINT_TABLE).count() if table_exists else 0
    )

    n_chunks = max(1, -(-n_to_process // CHUNK_TARGETS))

    # even, stateless chunking by hash (no id lists collected)
    chunked = targets.withColumn(
        "_chunk_id",
        F.pmod(F.hash(*KEY_COLS), F.lit(n_chunks))
    )

    for chunk_id in range(n_chunks):

        chunk_df = (
            chunked
            .filter(F.col("_chunk_id") == chunk_id)
            .drop("_chunk_id")
        )

        (
            chunk_df
            .repartition(N_PARTITIONS)
            .mapInPandas(
                process_partition_pandas,
                schema=TRIPLES_SCHEMA
            )
            .write
            .mode("append")
            .option("mergeSchema", "true")
            .saveAsTable(CHECKPOINT_TABLE)
        )

        print(f"  chunk {chunk_id + 1}/{n_chunks} saved")

    # Count from the SAVED table -- never from the lazy DataFrame,
    # which would re-run every LLM call.
    rows_after = spark.table(CHECKPOINT_TABLE).count()

    print(f"Relationships extracted this run            : {rows_after - rows_before}")
    print(f"Checkpointed to                             : {CHECKPOINT_TABLE}")


# ==========================================================
# 4. LOAD RESULT
#
#   triples_all_df = everything in the checkpoint table
#   triples_df     = usable rows only (feeds Cell 11 / 12)
# ==========================================================

if not spark.catalog.tableExists(CHECKPOINT_TABLE):

    raise RuntimeError(
        f"{CHECKPOINT_TABLE} does not exist and there was nothing to "
        f"process. Check sentences_df."
    )

triples_all_df = spark.table(CHECKPOINT_TABLE)

if "status" in triples_all_df.columns:

    # NULL status = rows written before the status column existed
    triples_df = triples_all_df.filter(
        (F.col("status") == "ok") | F.col("status").isNull()
    )

    status_col = F.coalesce(F.col("status"), F.lit("legacy"))

else:

    triples_df = triples_all_df
    status_col = F.lit("legacy")

triples_df = triples_df.cache()

n_all = triples_all_df.count()
n_usable = triples_df.count()

print()
print(f"Rows in checkpoint table (all statuses) : {n_all}")
print(f"triples_df (usable, feeds Cell 11)       : {n_usable}")
print(f"Targets expected from sentences_df       : {n_targets_total}")
print()


# ==========================================================
# 5. QUALITY SUMMARY
# ==========================================================

print("Rows by status (legacy = written before the status column existed):")

display(
    triples_all_df
    .groupBy(status_col.alias("status"))
    .count()
    .orderBy(F.col("count").desc())
)

if "status" in triples_all_df.columns:

    n_bad = triples_all_df.filter(F.col("status") == "failed").count()

    if n_bad:
        print(
            f"WARNING: {n_bad} targets failed (API errors / timeouts) and "
            f"are NOT in triples_df. Re-run this cell to retry them."
        )

    n_parse = triples_all_df.filter(F.col("status") == "parse_error").count()

    if n_parse:
        print(
            f"NOTE: {n_parse} targets returned an unparseable answer and "
            f"are NOT in triples_df (look at their description)."
        )

if n_usable < n_targets_total:
    print(
        f"NOTE: triples_df has {n_targets_total - n_usable} fewer rows than "
        f"targets in sentences_df (failed / parse_error / not yet run)."
    )

print()
print("Top predicates (a long tail of near-duplicates = canonicalize later):")

display(
    triples_df
    .groupBy("predicate")
    .count()
    .orderBy(F.col("count").desc())
    .limit(25)
)


# ==========================================================
# 6. SAMPLE TRIPLES
# ==========================================================

print()
print("Sample triples (source_title --[predicate, strength]--> target_title):")

display(
    triples_df.select(
        "source_title", "predicate", "relationship_strength",
        "target_title", "relationship_description", "link_type",
        "mention_count", "evidence_sentence"
    )
)
