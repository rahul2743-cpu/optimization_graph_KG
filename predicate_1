# ==========================================================
# 5. UNRESOLVED DOCUMENT MARKUP
# ==========================================================

# Examples:
#
# <doc:wiki:Temp_Import....>
#
# These are NOT target entities.
#
# Only resolved target_title values from sentences_df
# are allowed into the LLM extraction pipeline.

_UNRESOLVED_MARKUP_RE = re.compile(
    r"\[?<doc:(?:wiki:)?[^<>]+>\]?"
)


# ==========================================================
# 6. SANITIZE DOCUMENT TEXT
# ==========================================================

def _sanitize_for_llm(text):
    """
    Remove unresolved document markup.

    Resolved target hyperlinks such as:

        <MTCCM>

    are preserved.
    """

    text = text or ""

    text = _UNRESOLVED_MARKUP_RE.sub(
        " ",
        text
    )

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


# ==========================================================
# 7. NORMALIZE PREDICATE
# ==========================================================

def _to_snake_case(s):
    """
    Convert LLM predicate into lowercase snake_case.
    """

    s = (s or "").strip().lower()

    s = re.sub(
        r"[^a-z0-9]+",
        "_",
        s
    )

    s = re.sub(
        r"_+",
        "_",
        s
    )

    s = s.strip("_")

    return s or "related_to"


# ==========================================================
# 8. SPLIT SENTENCES SAFELY
# ==========================================================

def _split_sentences(text):
    """
    Split text into sentences.

    Important:
    Periods inside <Target.Title> should NOT be treated
    as sentence boundaries.
    """

    text = text or ""

    text = re.sub(
        r"\s+",
        " ",
        text
    ).strip()

    if not text:
        return []

    # ------------------------------------------------------
    # Temporarily mask everything inside < ... >
    #
    # This prevents periods inside a target title from
    # breaking the sentence.
    # ------------------------------------------------------

    spans = []

    def mask_match(match):
        spans.append(match.group(0))

        return (
            " <"
            + ("X" * max(1, len(match.group(0)) - 2))
            + "> "
        )

    masked = re.sub(
        r"<[^<>]+>",
        mask_match,
        text
    )

    # ------------------------------------------------------
    # Split sentences
    # ------------------------------------------------------

    parts = re.split(
        r"(?<=[.!?])\s+",
        masked
    )

    # ------------------------------------------------------
    # Restore hyperlinks
    # ------------------------------------------------------

    restored = []

    for sentence in parts:

        sentence = sentence.strip()

        if not sentence:
            continue

        def restore_match(match):

            if not spans:
                return match.group(0)

            original = spans.pop(0)

            return original

        # The masking restoration above is easier done by
        # replacing each placeholder sequentially.
        # Rebuild using the same placeholder structure.

        restored_sentence = sentence

        # Actual restoration using stored spans.
        # Since sentence splitting preserves placeholder count,
        # restore placeholders in order.

        placeholder_pattern = re.compile(r"<X+>")

        while True:

            m = placeholder_pattern.search(
                restored_sentence
            )

            if not m:
                break

            # Use first remaining matching original span.
            # The sentence itself contains target placeholders.
            # Search globally from original text if necessary.
            if spans:
                replacement = spans.pop(0)
            else:
                replacement = m.group(0)

            restored_sentence = (
                restored_sentence[:m.start()]
                + replacement
                + restored_sentence[m.end():]
            )

        restored.append(
            restored_sentence.strip()
        )

    return restored


# ==========================================================
# 9. ROBUST SENTENCE FINDER
# ==========================================================

def _find_sentence_for_entity(
    text,
    entity_name
):
    """
    Find the sentence containing:

        <Entity Name>

    Example:

        Any changes made will be lost if <MTCCM> is uninstalled.
    """

    text = _sanitize_for_llm(text)

    if not text:
        return ""

    # ------------------------------------------------------
    # Target pattern
    # ------------------------------------------------------

    target_pattern = re.compile(
        rf"<\s*{re.escape(entity_name)}\s*>",
        flags=re.IGNORECASE
    )

    match = target_pattern.search(text)

    if not match:
        return ""

    # ------------------------------------------------------
    # Instead of naive sentence splitting, find sentence
    # boundaries around the exact target.
    #
    # Ignore punctuation occurring inside <...>.
    # ------------------------------------------------------

    spans = [
        m.span()
        for m in re.finditer(
            r"<[^<>]+>",
            text
        )
    ]

    def inside_link(pos):
        for start, end in spans:
            if start <= pos < end:
                return True

        return False

    # ------------------------------------------------------
    # Find left boundary
    # ------------------------------------------------------

    left = 0

    i = match.start() - 1

    while i >= 0:

        if (
            text[i] in ".!?"
            and not inside_link(i)
        ):
            left = i + 1
            break

        i -= 1

    # ------------------------------------------------------
    # Find right boundary
    # ------------------------------------------------------

    right = len(text)

    i = match.end()

    while i < len(text):

        if (
            text[i] in ".!?"
            and not inside_link(i)
        ):
            right = i + 1
            break

        i += 1

    sentence = text[
        left:right
    ].strip()

    return sentence


# ==========================================================
# 10. EXTRACT 6-WORD LOCAL CONTEXT
# ==========================================================

def _extract_local_context(
    sentence,
    entity_name,
    window=6
):
    """
    Extract:

        6 words before
        +
        <TARGET>
        +
        6 words after
    """

    if not sentence:
        return ""

    pattern = re.compile(
        rf"<\s*{re.escape(entity_name)}\s*>",
        flags=re.IGNORECASE
    )

    match = pattern.search(sentence)

    if not match:
        return ""

    # ------------------------------------------------------
    # Before target
    # ------------------------------------------------------

    before = sentence[
        :match.start()
    ].strip()

    # ------------------------------------------------------
    # After target
    # ------------------------------------------------------

    after = sentence[
        match.end():
    ].strip()

    # ------------------------------------------------------
    # Extract words
    # ------------------------------------------------------

    before_words = re.findall(
        r"\S+",
        before
    )

    after_words = re.findall(
        r"\S+",
        after
    )

    # Last 6 before
    before_words = before_words[
        -window:
    ]

    # First 6 after
    after_words = after_words[
        :window
    ]

    hyperlink = match.group(0)

    local_context = (
        " ".join(before_words)
        + " "
        + hyperlink
        + " "
        + " ".join(after_words)
    )

    return re.sub(
        r"\s+",
        " ",
        local_context
    ).strip()


# ==========================================================
# 11. BUILD CONTEXT FOR ONE TARGET
# ==========================================================

def _build_entity_context(
    content,
    entity_name
):
    """
    For ONE target:

        document
            ↓
        find target
            ↓
        find sentence
            ↓
        extract 6-word local context
    """

    sentence = _find_sentence_for_entity(
        content,
        entity_name
    )

    if not sentence:
        return "", ""

    local_context = _extract_local_context(
        sentence,
        entity_name,
        LOCAL_CONTEXT_WORDS
    )

    # ------------------------------------------------------
    # Limit very long sentences
    # ------------------------------------------------------

    if len(sentence) > MAX_SENTENCE_CHARS:

        sentence = (
            sentence[:MAX_SENTENCE_CHARS]
            + " ...[sentence truncated]"
        )

    return (
        sentence,
        local_context
    )


# ==========================================================
# 12. PARSE ONE LLM RESPONSE
# ==========================================================

def _parse_single_record(
    text,
    entity_name
):
    """
    Parse ONE LLM response.

    Expected:

        Entity
        <|>
        predicate
        <|>
        description
        <|>
        strength
        ##
    """

    if not text:

        return (
            "related_to",
            "",
            5
        )

    # ------------------------------------------------------
    # First record only
    # ------------------------------------------------------

    record = (
        text
        .split(RECORD_DELIM)[0]
        .strip()
        .strip(",")
    )

    parts = [
        p.strip()
        for p in record.split(
            TUPLE_DELIM
        )
    ]

    # ------------------------------------------------------
    # Validate
    # ------------------------------------------------------

    if len(parts) < 3:

        return (
            "related_to",
            "",
            5
        )

    # ------------------------------------------------------
    # Predicate
    # ------------------------------------------------------

    predicate = _to_snake_case(
        parts[1]
    )

    # ------------------------------------------------------
    # Description
    # ------------------------------------------------------

    description = parts[2]

    # ------------------------------------------------------
    # Strength
    # ------------------------------------------------------

    try:

        strength_text = (
            parts[3]
            if len(parts) > 3
            else "5"
        )

        numbers = re.sub(
            r"\D",
            "",
            strength_text
        )

        strength = int(
            numbers
        )

        strength = max(
            1,
            min(
                10,
                strength
            )
        )

    except (
        ValueError,
        TypeError
    ):

        strength = 5

    return (
        predicate,
        description,
        strength
    )


# ==========================================================
# 13. DISTRIBUTED WORKER
# ==========================================================

def process_partition_pandas(
    pdf_iterator
):

    import pandas as pd

    from langchain_openai import ChatOpenAI

    # ------------------------------------------------------
    # One LLM client per Spark partition.
    # ------------------------------------------------------

    partition_llm = ChatOpenAI(
        model=_CONN["model"],
        base_url=_CONN["base_url"],
        api_key=_CONN["api_key"],
        temperature=0,
        timeout=60,
        max_retries=0,
    )

    out_columns = [
        "source_node",
        "source_title",
        "predicate",
        "relationship_description",
        "relationship_strength",
        "target_title",
        "target_reference",
        "link_type",
    ]

    # ------------------------------------------------------
    # Process Spark Arrow batches
    # ------------------------------------------------------

    for pdf in pdf_iterator:

        out_rows = []

        # --------------------------------------------------
        # DOCUMENT LOOP
        # --------------------------------------------------

        for _, row in pdf.iterrows():

            entities = row["entities"]

            source_title = row["source_title"]

            content = row["content_with_titles"]

            # ------------------------------------------------
            # TARGET LOOP
            #
            # ONE TARGET AT A TIME
            # ------------------------------------------------

            for entity in entities:

                target_title = entity["target_title"]

                target_reference = (
                    entity["target_reference"]
                )

                link_type = (
                    entity["link_type"]
                )

                try:

                    # ========================================
                    # STEP 1
                    # SOURCE
                    # ========================================

                    source_node = source_title


                    # ========================================
                    # STEP 2
                    # FIND SENTENCE
                    # ========================================

                    sentence, local_context = (
                        _build_entity_context(
                            content,
                            target_title
                        )
                    )


                    # ========================================
                    # STEP 3
                    # NO SENTENCE
                    # ========================================

                    if not sentence:

                        predicate = "related_to"

                        description = (
                            "[No sentence containing "
                            "target hyperlink was found]"
                        )

                        strength = 1

                    else:

                        # ==================================
                        # STEP 4
                        # ONE TARGET PROMPT
                        # ==================================

                        user_prompt = f"""
SOURCE DOCUMENT TITLE:
{source_title}

TARGET ENTITY:
{target_title}

FULL SENTENCE CONTAINING THE TARGET:
{sentence}

FOCUSED LOCAL CONTEXT:
{local_context}

TASK:

Determine the ONE semantic relationship between:

SOURCE:
{source_title}

TARGET:
{target_title}

Use the full sentence as the primary context.

Use the local context as additional focused context.

Return exactly ONE predicate.
"""


                        # ==================================
                        # STEP 5
                        # ONE LLM CALL
                        # ==================================

                        resp = None

                        last_error = None

                        for attempt in range(
                            1,
                            MAX_RETRIES + 1
                        ):

                            try:

                                resp = partition_llm.invoke(
                                    [
                                        {
                                            "role": "system",
                                            "content": SYSTEM_PROMPT,
                                        },
                                        {
                                            "role": "user",
                                            "content": user_prompt,
                                        },
                                    ]
                                )

                                break

                            except Exception as e:

                                last_error = e

                                if attempt < MAX_RETRIES:

                                    time.sleep(
                                        RETRY_SLEEP_SECONDS
                                        * attempt
                                    )

                        # ----------------------------------
                        # LLM completely failed
                        # ----------------------------------

                        if resp is None:

                            raise RuntimeError(
                                f"LLM failed after "
                                f"{MAX_RETRIES} attempts: "
                                f"{last_error}"
                            )


                        # ==================================
                        # STEP 6
                        # PARSE ONE PREDICATE
                        # ==================================

                        (
                            predicate,
                            description,
                            strength
                        ) = _parse_single_record(
                            resp.content.strip(),
                            target_title
                        )


                except Exception as e:

                    # --------------------------------------
                    # One target failure does NOT kill the
                    # whole document.
                    # --------------------------------------

                    predicate = "related_to"

                    description = (
                        f"[extraction failed: {e}]"
                    )

                    strength = 1


                # ==========================================
                # STEP 7
                # CREATE ONE RDF RELATIONSHIP
                # ==========================================

                out_rows.append(
                    {

                        # SOURCE = DOCUMENT TITLE
                        "source_node":
                            source_title,

                        "source_title":
                            source_title,

                        "predicate":
                            predicate,

                        "relationship_description":
                            description,

                        "relationship_strength":
                            strength,

                        # TARGET = RESOLVED TARGET TITLE
                        "target_title":
                            target_title,

                        "target_reference":
                            target_reference,

                        "link_type":
                            link_type,
                    }
                )

        # --------------------------------------------------
        # Yield current Arrow batch
        # --------------------------------------------------

        yield pd.DataFrame(
            out_rows,
            columns=out_columns
        )


