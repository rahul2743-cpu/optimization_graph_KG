# ==========================================================
# 6. UNRESOLVED MARKUP
# ==========================================================

# Raw unresolved references such as:
#
# <doc:wiki:Temp_Import....>
#
# are NOT targets.

_UNRESOLVED_MARKUP_RE = re.compile(
    r"\[?<doc:(?:wiki:)?[^<>]+>\]?"
)


# ==========================================================
# 7. MARKUP / SENTENCE HELPERS
# ==========================================================

_MARKUP_SPAN_RE = re.compile(
    r"<[^<>]*>"
)


_BOUNDARY_RE = re.compile(
    r"[.!?][\"')\]]*(?=\s|$)|\n"
)


_ABBREVIATIONS = {
    "e.g",
    "i.e",
    "etc",
    "vs",
    "inc",
