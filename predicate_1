TUPLE_DELIM = "<|>"
RECORD_DELIM = "##"

# ----------------------------------------------------------
# 3. SYSTEM PROMPT
# ----------------------------------------------------------

SYSTEM_PROMPT = f"""
You extract ONE semantic relationship for a knowledge graph.

INPUT:
1. SOURCE document title.
2. ONE TARGET entity.
3. FULL SENTENCE containing the target.
4. LOCAL CONTEXT of approximately six words before and after target.

IMPORTANT:
- There is ONLY ONE target.
- Return ONLY ONE predicate.
- Do not identify additional entities.
- Do not create additional graph nodes.
- Do not create multiple predicates.
- Do not invent relationships.

SOURCE:
The SOURCE is the document title.

TARGET:
The TARGET is the explicitly supplied entity.

DIRECTION:
SOURCE -> predicate -> TARGET

The full sentence is the primary evidence.
The local context provides additional focused evidence.

PREDICATE:
- exactly one
- lowercase
- snake_case
- 1 to 5 words
- grounded in the sentence

Examples:
uses
depends_on
contains
supports
belongs_to
controlled_by
mentions
related_to

If merely referenced/listed: mentions
If genuinely unclear: related_to

STRENGTH:
Return integer 1-10.

OUTPUT EXACTLY:
<Entity Name>{TUPLE_DELIM}<predicate>{TUPLE_DELIM}<description>{TUPLE_DELIM}<strength>{RECORD_DELIM}

No JSON.
No markdown.
No additional explanation.
"""

# ----------------------------------------------------------
# 4. TEXT HELPERS
# ----------------------------------------------------------

_UNRESOLVED_MARKUP_RE = re.compile(
    r"\[?<doc:(?:wiki:)?[^<>]+>\]?"
)

_LINK_RE = re.compile(r"<[^<>]+>")


def _sanitize_text(text):
    text = text or ""
    text = _UNRESOLVED_MARKUP_RE.sub(" ", text)
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def _target_pattern(target_title):
    words = (target_title or "").split()

    if not words:
        return None

    return re.compile(
        r"<\s*" +
        r"\s+".join(re.escape(w) for w in words) +
        r"\s*>",
        re.IGNORECASE
    )


def _prepare_document(content):
    text = _sanitize_text(content)

    masked = _LINK_RE.sub(
        lambda m: "x" * len(m.group(0)),
        text
    )

    return text, masked


# ----------------------------------------------------------
# 5. FIND SENTENCE CONTAINING TARGET
# ----------------------------------------------------------

def _find_sentence_for_target(prepared_document, target_title):

    text, masked = prepared_document

    if not text:
        return ""

    pattern = _target_pattern(target_title)

    if pattern is None:
        return ""

    match = pattern.search(text)

    if not match:
        return ""

    start = match.start()
    end = match.end()

    sentence_start = 0

    for i in range(start - 1, -1, -1):
        if masked[i] in ".!?":
            sentence_start = i + 1
            break

    sentence_end = len(text)

    for i in range(end, len(text)):
        if masked[i] in ".!?":
            sentence_end = i + 1
            break

    return text[sentence_start:sentence_end].strip()


# ----------------------------------------------------------
# 6. LOCAL CONTEXT
# ----------------------------------------------------------

def _extract_local_context(sentence, target_title):

    if not sentence:
        return ""

    pattern = _target_pattern(target_title)

    if pattern is None:
        return ""

    match = pattern.search(sentence)

    if not match:
        return ""

    before = (
        sentence[:match.start()]
        .split()[-LOCAL_CONTEXT_WORDS:]
    )

    after = (
        sentence[match.end():]
        .split()[:LOCAL_CONTEXT_WORDS]
    )

    return " ".join(
        before +
        [match.group(0)] +
        after
    )


def _build_target_context(prepared_document, target_title):

    sentence = _find_sentence_for_target(
        prepared_document,
        target_title
    )

    if not sentence:
        return "", ""

    local_context = _extract_local_context(
        sentence,
        target_title
    )

    if len(sentence) > MAX_SENTENCE_CHARS:

        pattern = _target_pattern(target_title)
        match = pattern.search(sentence) if pattern else None

        if match:
            center = match.start()
            half = MAX_SENTENCE_CHARS // 2
            start = max(0, center - half)
            end = min(
                len(sentence),
                start + MAX_SENTENCE_CHARS
            )
            sentence = sentence[start:end]
        else:
            sentence = sentence[:MAX_SENTENCE_CHARS]

    return sentence, local_context


# ----------------------------------------------------------
# 7. PREDICATE NORMALIZATION
# ----------------------------------------------------------

_PREDICATE_ALIASES = {
    "is_related_to": "related_to",
    "relates_to": "related_to",
    "refers_to": "mentions",
    "references": "mentions",
    "utilizes": "uses",
    "utilises": "uses",
    "relies_on": "depends_on",
    "is_dependent_on": "depends_on",
}


def _normalize_predicate(predicate):

    predicate = (predicate or "").strip().lower()

    predicate = re.sub(
        r"[^a-z0-9]+",
        "_",
        predicate
    )

    predicate = re.sub(
        r"_+",
        "_",
        predicate
    ).strip("_")

    predicate = predicate or "related_to"

    predicate = _PREDICATE_ALIASES.get(
        predicate,
        predicate
    )

    words = predicate.split("_")

    if len(words) > 5:
        predicate = "_".join(words[:5])

    return predicate or "related_to"


# ----------------------------------------------------------
# 8. PARSE LLM RESPONSE
# ----------------------------------------------------------

def _parse_llm_response(response_text):

    if not response_text:
        return (
            "related_to",
            "",
            1,
            "parse_error"
        )

    record = (
        response_text
        .split(RECORD_DELIM)[0]
        .strip()
    )

    parts = [
        x.strip()
        for x in record.split(TUPLE_DELIM)
    ]

    if len(parts) < 3:
        return (
            "related_to",
            f"[Unparseable response: {response_text[:300]}]",
            1,
            "parse_error"
        )

    predicate = _normalize_predicate(parts[1])
    description = parts[2]

    strength = 5

    if len(parts) >= 4:
        match = re.search(r"\d+", parts[3])

        if match:
            strength = max(
                1,
                min(10, int(match.group()))
            )

    return (
        predicate,
        description,
        strength,
        "ok"
    )


# ----------------------------------------------------------
# 9. ONE TARGET -> ONE LLM CALL
# ----------------------------------------------------------

def _extract_one_target(
    llm,
    source_title,
    prepared_document,
    target_title
):

    sentence, local_context = _build_target_context(
        prepared_document,
        target_title
    )

    if not sentence:
        return {
            "predicate": "related_to",
            "description": (
                "[No sentence containing target hyperlink was found]"
            ),
            "strength": 1,
            "status": "no_sentence",
            "evidence_sentence": "",
        }

    user_prompt = f"""
SOURCE DOCUMENT TITLE:
{source_title}

TARGET ENTITY:
{target_title}

FULL SENTENCE CONTAINING THE TARGET:
{sentence}

FOCUSED LOCAL CONTEXT:
{local_context}

TASK:
Determine the ONE semantic relationship:

SOURCE:
{source_title}

TARGET:
{target_title}

The SOURCE is the subject.
The TARGET is the object.

Use the full sentence as primary evidence.
Use local context as additional evidence.

Return exactly ONE predicate.
"""

    last_error = None

    for attempt in range(1, LLM_MAX_RETRIES + 1):

        try:

            response = llm.invoke([
                {
                    "role": "system",
                    "content": SYSTEM_PROMPT,
                },
                {
                    "role": "user",
                    "content": user_prompt,
                },
            ])

            response_text = (
                getattr(response, "content", "")
                or ""
            )

            (
                predicate,
                description,
                strength,
                status,
            ) = _parse_llm_response(
                response_text
            )

            return {
                "predicate": predicate,
                "description": description,
                "strength": strength,
                "status": status,
                "evidence_sentence":
                    sentence[:MAX_EVIDENCE_CHARS],
            }

        except Exception as e:

            last_error = e

            if attempt < LLM_MAX_RETRIES:
                time.sleep(
                    RETRY_SLEEP_SECONDS * attempt
                )

    return {
        "predicate": "related_to",
        "description": (
            f"[extraction failed: "
            f"{type(last_error).__name__}: "
            f"{str(last_error)[:300]}]"
        ),
        "strength": 1,
        "status": "failed",
        "evidence_sentence":
            sentence[:MAX_EVIDENCE_CHARS],
    }


# ----------------------------------------------------------
# 10. DISTRIBUTED WORKER
# ----------------------------------------------------------

def process_partition_pandas(pdf_iterator):

    import pandas as pd
    from langchain_openai import ChatOpenAI

    partition_llm = ChatOpenAI(
        model=_CONN["model"],
        base_url=_CONN["base_url"],
        api_key=_CONN["api_key"],
        temperature=0,
        max_retries=0,
        timeout=LLM_TIMEOUT_SECONDS,
        max_tokens=LLM_MAX_TOKENS,
    )

    out_columns = [
        "source_node",
        "source_title",
        "predicate",
        "relationship_description",
        "relationship_strength",
        "target_title",
        "target_reference",
        "link_type",
        "status",
        "evidence_sentence",
        "mention_count",
    ]

    for pdf in pdf_iterator:

        out_rows = []

        for _, row in pdf.iterrows():

            source_title = row["source_title"]
            content = row["content_with_titles"]
            entities = row["entities"]

            prepared_document = _prepare_document(
                content
            )

            for entity in entities:

                target_title = entity["target_title"]

                result = _extract_one_target(
                    partition_llm,
                    source_title,
                    prepared_document,
                    target_title
                )

                out_rows.append({
                    "source_node": source_title,
                    "source_title": source_title,
                    "predicate": result["predicate"],
                    "relationship_description":
                        result["description"],
                    "relationship_strength":
                        result["strength"],
                    "target_title": target_title,
                    "target_reference":
                        entity["target_reference"],
                    "link_type":
                        entity["link_type"],
                    "status": result["status"],
                    "evidence_sentence":
                        result["evidence_sentence"],
                    "mention_count":
                        int(entity["mention_count"]),
                })

        yield pd.DataFrame(
            out_rows,
            columns=out_columns
        )


# ----------------------------------------------------------
# 11. OUTPUT SCHEMA
# ----------------------------------------------------------

TRIPLES_SCHEMA = StructType([
    StructField("source_node", StringType()),
    StructField("source_title", StringType()),
    StructField("predicate", StringType()),
    StructField("relationship_description", StringType()),
    StructField("relationship_strength", IntegerType()),
    StructField("target_title", StringType()),
    StructField("target_reference", StringType()),
    StructField("link_type", StringType()),
    StructField("status", StringType()),
    StructField("evidence_sentence", StringType()),
    StructField("mention_count", IntegerType()),
])

# ----------------------------------------------------------
# 12. RESOLVED TARGETS
# ----------------------------------------------------------

print("=" * 80)
print("BUILDING DOCUMENT-TARGET WORK ITEMS")
print("=" * 80)

resolved_occurrences = (
    sentences_df
    .filter(F.col("is_resolved") == True)
    .filter(F.col("target_title").isNotNull())
    .filter(F.trim(F.col("target_title")) != "")
)

KEY_COLS = [
    "source_node",
    "target_title"
]

mention_counts = (
    resolved_occurrences
    .groupBy(*KEY_COLS)
    .agg(
        F.count(F.lit(1))
        .cast("int")
        .alias("mention_count")
    )
)

first_window = (
    Window
    .partitionBy(*KEY_COLS)
    .orderBy(F.col("occurrence").asc())
)

targets_all = (
    resolved_occurrences
    .withColumn(
        "_rn",
        F.row_number().over(first_window)
    )
    .filter(F.col("_rn") == 1)
    .drop("_rn")
    .join(
        mention_counts,
        on=KEY_COLS,
        how="left"
    )
    .select(
        "source_node",
        "source_title",
        "target_reference",
        "target_title",
        "link_type",
        "mention_count"
    )
)

print(
    f"Resolved occurrences : "
    f"{resolved_occurrences.count()}"
)

print(
    f"Document-target pairs : "
    f"{mention_counts.count()}"
)

# ----------------------------------------------------------
# 13. CHECKPOINT
# ----------------------------------------------------------

table_exists = spark.catalog.tableExists(
    CHECKPOINT_TABLE
)

if table_exists:

    checkpoint_df = spark.table(
        CHECKPOINT_TABLE
    )

    if "status" in checkpoint_df.columns:

        if RETRY_FAILED:

            already_done = (
                checkpoint_df
                .filter(F.col("status") == "ok")
                .select(*KEY_COLS)
                .distinct()
            )

            failed_count = (
                checkpoint_df
                .filter(F.col("status") == "failed")
                .select(*KEY_COLS)
                .distinct()
                .count()
            )

            print(
                f"Previously failed targets: {failed_count}"
            )

        else:

            already_done = (
                checkpoint_df
                .select(*KEY_COLS)
                .distinct()
            )

    else:

        already_done = (
            checkpoint_df
            .select(*KEY_COLS)
            .distinct()
        )

    targets_to_process = (
        targets_all
        .join(
            already_done,
            on=KEY_COLS,
            how="left_anti"
        )
    )

    print(
        f"Checkpointed targets skipped: "
        f"{already_done.count()}"
    )

else:

    targets_to_process = targets_all

    print("No checkpoint table found.")
    print("Starting new checkpoint.")

n_to_process = targets_to_process.count()

print(
    f"Targets to process: {n_to_process}"
)

# ----------------------------------------------------------
# 14. CHUNK PROCESSING
# ----------------------------------------------------------

if n_to_process > 0:

    n_chunks = max(
        1,
        (n_to_process + CHUNK_TARGETS - 1)
        // CHUNK_TARGETS
    )

    chunked = (
        targets_to_process
        .withColumn(
            "_chunk_id",
            F.pmod(
                F.hash(*KEY_COLS),
                F.lit(n_chunks)
            )
        )
    )

    print(
        f"Total chunks: {n_chunks}"
    )

    rows_before = (
        spark.table(CHECKPOINT_TABLE).count()
        if table_exists
        else 0
    )

    for chunk_id in range(n_chunks):

        print(
            f"Processing chunk "
            f"{chunk_id + 1}/{n_chunks}"
        )

        chunk_targets = (
            chunked
            .filter(
                F.col("_chunk_id") == chunk_id
            )
            .drop("_chunk_id")
        )

        chunk_doc_entities = (
            chunk_targets
            .groupBy(
                "source_node",
                "source_title"
            )
            .agg(
                F.collect_list(
                    F.struct(
                        "target_title",
                        "target_reference",
                        "link_type",
                        "mention_count",
                    )
                ).alias("entities")
            )
        )

        chunk_input = (
            chunk_doc_entities
            .join(
                document_rendered_df.select(
                    "source_node",
                    "content_with_titles",
                ),
                on="source_node",
                how="inner"
            )
        )

        (
            chunk_input
            .repartition(N_PARTITIONS)
            .mapInPandas(
                process_partition_pandas,
                schema=TRIPLES_SCHEMA
            )
            .write
            .mode("append")
            .option("mergeSchema", "true")
            .saveAsTable(CHECKPOINT_TABLE)
        )

        print(
            f"Chunk {chunk_id + 1}/{n_chunks} saved."
        )

    rows_after = (
        spark.table(CHECKPOINT_TABLE).count()
    )

    print(
        f"Rows written this run: "
        f"{rows_after - rows_before}"
    )

else:

    print(
        "Nothing to process. "
        "All targets are already checkpointed."
    )

# ----------------------------------------------------------
# 15. LOAD FINAL RESULTS
# ----------------------------------------------------------

if not spark.catalog.tableExists(
    CHECKPOINT_TABLE
):
    raise RuntimeError(
        f"Checkpoint table does not exist: "
        f"{CHECKPOINT_TABLE}"
    )

triples_all_df = spark.table(
    CHECKPOINT_TABLE
)

if "status" in triples_all_df.columns:

    triples_df = (
        triples_all_df
        .filter(F.col("status") == "ok")
    )

else:

    triples_df = triples_all_df

# ----------------------------------------------------------
# IMPORTANT:
# NO CACHE USED
# ----------------------------------------------------------

n_all = triples_all_df.count()
n_usable = triples_df.count()

print("=" * 80)
print("CELL 10 COMPLETE")
print("=" * 80)

print(
    f"All checkpoint rows : {n_all}"
)

print(
    f"Usable triples_df   : {n_usable}"
)

if "status" in triples_all_df.columns:

    display(
        triples_all_df
        .groupBy("status")
        .count()
        .orderBy(
            F.col("count").desc()
        )
    )

print("Top predicates:")

display(
    triples_df
    .groupBy("predicate")
    .count()
    .orderBy(
        F.col("count").desc()
    )
    .limit(25)
)

print("Sample triples:")

display(
    triples_df.select(
        "source_title",
        "predicate",
        "relationship_strength",
        "target_title",
        "relationship_description",
        "link_type",
        "mention_count",
        "evidence_sentence",
    )
)
