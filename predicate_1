def _to_snake_case(s):

    s = (
        s or ""
    ).strip().lower()

    s = re.sub(
        r"[^a-z0-9]+",
        "_",
        s
    )

    s = re.sub(
        r"_+",
        "_",
        s
    )

    s = s.strip("_")

    return (
        s
        or
        "related_to"
    )


def _normalize_predicate(s):

    predicate = _to_snake_case(s)

    predicate = PREDICATE_ALIASES.get(
        predicate,
        predicate
    )

    words = predicate.split("_")

    if len(words) > 5:

        predicate = "_".join(
            words[:5]
        )

    return (
        predicate
        or
        "related_to"
    )


# ==========================================================
# 9. LLM RESPONSE TEXT
# ==========================================================

def _response_text(resp):

    content = getattr(
        resp,
        "content",
        resp
    )

    if isinstance(
        content,
        list
    ):

        parts = []

        for block in content:

            if isinstance(
                block,
                dict
            ):

                if block.get(
                    "type"
                ) in (
                    None,
                    "text"
                ):

                    parts.append(
                        block.get(
                            "text",
                            ""
                        )
                        or
                        ""
                    )

            else:

                parts.append(
                    str(block)
                )

        return "".join(
            parts
        ).strip()

    return str(
        content
        or
        ""
    ).strip()


# ==========================================================
# 10. CLEAN DOCUMENT
# ==========================================================

def _sanitize_for_llm(text):

    text = (
        text
        or
        ""
    )

    # Remove unresolved wiki/document markup.
    text = _UNRESOLVED_MARKUP_RE.sub(
        " ",
        text
    )

    # Normalize whitespace.
    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


# ==========================================================
# 11. TARGET REGEX
# ==========================================================

def _target_pattern(entity_name):

    words = (
        entity_name
        or
        ""
    ).split()

    if not words:

        return None

    return re.compile(
        r"<\s*"
        +
        r"\s+".join(
            re.escape(w)
            for w in words
        )
        +
        r"\s*>",
        flags=re.IGNORECASE
    )


# ==========================================================
# 12. PREPARE DOCUMENT
# ==========================================================

def _prepare_document(content):

    text = _UNRESOLVED_MARKUP_RE.sub(
        " ",
        content
        or
        ""
    )

    # Mask hyperlinks so that periods inside:
    #
    # <MTCCM.Run>
    #
    # do not become sentence boundaries.

    masked = _MARKUP_SPAN_RE.sub(
        lambda m:
            "x" * len(
                m.group(0)
            ),
        text
    )

    return (
        text,
        masked
    )


# ==========================================================
# 13. SENTENCE BOUNDARY
# ==========================================================

def _is_sentence_boundary(
    masked,
    match
):

    token = match.group(0)

    if (
        token == "\n"
        or
        token[0] != "."
    ):

        return True

    before = masked[
        max(
            0,
            match.start() - 30
        ):
        match.start()
    ]

    last = re.search(
        r"(\S+)$",
        before
    )

    if not last:

        return True

    word = (
        last.group(1)
        .lower()
        .lstrip(
            "(['\""
        )
    )

    if word in _ABBREVIATIONS:

        return False

    if (
        len(word) == 1
        and
        word.isalpha()
    ):

        return False

    return True


# ==========================================================
# 14. FIND SENTENCE FOR ONE TARGET
# ==========================================================

def _find_sentence_for_entity(
    doc,
    entity_name
):

    text, masked = doc

    pattern = _target_pattern(
        entity_name
    )

    if (
        pattern is None
        or
        not text
    ):

        return ""

    target_match = pattern.search(
        text
    )

    if not target_match:

        return ""

    # ------------------------------------------------------
    # Search left
    # ------------------------------------------------------

    lo = max(
        0,
        target_match.start()
        -
        MAX_SENTENCE_CHARS
    )

    start = lo

    for boundary in _BOUNDARY_RE.finditer(
        masked,
        lo,
        target_match.start()
    ):

        if _is_sentence_boundary(
            masked,
            boundary
        ):

            start = boundary.end()


    # ------------------------------------------------------
    # Search right
    # ------------------------------------------------------

    hi = min(
        len(text),
        target_match.end()
        +
        MAX_SENTENCE_CHARS
    )

    end = hi

    for boundary in _BOUNDARY_RE.finditer(
        masked,
        target_match.end(),
        hi
    ):

        if _is_sentence_boundary(
            masked,
            boundary
        ):

            end = boundary.end()

            break


    sentence = text[
        start:end
    ]

    return _sanitize_for_llm(
        sentence
    )


# ==========================================================
# 15. EXTRACT 6-WORD LOCAL CONTEXT
# ==========================================================

def _extract_local_context(
    sentence,
    entity_name,
    window=6
):

    pattern = _target_pattern(
        entity_name
    )

    if (
        not sentence
        or
        pattern is None
    ):

        return ""

    match = pattern.search(
        sentence
    )

    if not match:

        return ""

    before_words = (
        sentence[
            :match.start()
        ]
        .split()
        [-window:]
    )

    after_words = (
        sentence[
            match.end():
        ]
        .split()
        [:window]
    )

    return " ".join(
        before_words
        +
        [match.group(0)]
        +
        after_words
    )


# ==========================================================
# 16. KEEP TARGET INSIDE SENTENCE WINDOW
# ==========================================================

def _window_around_target(
    sentence,
    entity_name,
    max_chars
):

    if len(sentence) <= max_chars:

        return sentence

    pattern = _target_pattern(
        entity_name
    )

    match = (
        pattern.search(sentence)
        if pattern
        else
        None
    )

    center = (
        match.start()
        if match
        else
        0
    )

    start = max(
        0,
        center - max_chars // 2
    )

    end = min(
        len(sentence),
        start + max_chars
    )

    start = max(
        0,
        end - max_chars
    )

    prefix = (
        "...[truncated] "
        if start > 0
        else
        ""
    )

    suffix = (
        " ...[truncated]"
        if end < len(sentence)
        else
        ""
    )

    return (
        prefix
        +
        sentence[start:end]
        +
        suffix
    )


# ==========================================================
# 17. BUILD CONTEXT FOR ONE TARGET
# ==========================================================

def _build_entity_context(
    doc,
    entity_name
):

    sentence = _find_sentence_for_entity(
        doc,
        entity_name
    )

    local_context = _extract_local_context(
        sentence,
        entity_name,
        LOCAL_CONTEXT_WORDS
    )

    sentence = _window_around_target(
        sentence,
        entity_name,
        MAX_SENTENCE_CHARS
    )

    return (
        sentence,
        local_context
    )


# ==========================================================
# 18. PARSE ONE LLM RESPONSE
# ==========================================================

def _parse_single_record(text):

    if not text:

        return (
            "related_to",
            "[empty LLM response]",
            1,
            False
        )

    record = (
        text
        .split(
            RECORD_DELIM
        )[0]
        .strip()
        .strip(",")
    )

    parts = [
        p.strip()
        for p in record.split(
            TUPLE_DELIM
        )
    ]

    if len(parts) < 3:

        return (
            "related_to",
            (
                "[unparseable LLM response: "
                f"{text[:200]}]"
            ),
            1,
            False
        )

    predicate = _normalize_predicate(
        parts[1]
    )

    strength = 5

    description_parts = parts[2:]

    if len(parts) >= 4:

        match = re.search(
            r"\d+",
            parts[-1]
        )

        if match:

            strength = max(
                1,
                min(
                    10,
                    int(
                        match.group()
                    )
                )
            )

            description_parts = (
                parts[2:-1]
            )

    description = " ".join(
        p
        for p in description_parts
        if p
    )

    return (
        predicate,
        description,
        strength,
        True
    )


# ==========================================================
# 19. ONE TARGET -> ONE LLM CALL
# ==========================================================

def _extract_one(
    llm,
    source_title,
    doc,
    target_title
):

    sentence = ""

    try:

        # --------------------------------------------------
        # Find ONE target's sentence
        # --------------------------------------------------

        sentence, local_context = (
            _build_entity_context(
                doc,
                target_title
            )
        )


        # --------------------------------------------------
        # No sentence found
        # --------------------------------------------------

        if not sentence:

            return {

                "predicate":
                    "related_to",

                "description":
                    (
                        "[No sentence containing "
                        "target hyperlink was found]"
                    ),

                "strength":
                    1,

                "status":
                    "no_sentence",

                "sentence":
                    "",
            }


        # --------------------------------------------------
        # ONE TARGET PROMPT
        # --------------------------------------------------

        user_prompt = f"""
SOURCE DOCUMENT TITLE:
{source_title}


TARGET ENTITY:
{target_title}


FULL SENTENCE CONTAINING THE TARGET:
{sentence}


FOCUSED LOCAL CONTEXT:
{local_context}


TASK:

Determine the ONE semantic relationship between:

SOURCE:
{source_title}

TARGET:
{target_title}

The SOURCE is the subject.

The TARGET is the object.

Use the full sentence as the primary context.

Use the local context as additional focused context.

Return exactly ONE predicate.
"""


        # --------------------------------------------------
        # ONE LLM CALL
        # --------------------------------------------------

        response = llm.invoke(
            [
                {
                    "role":
                        "system",

                    "content":
                        SYSTEM_PROMPT,
                },

                {
                    "role":
                        "user",

                    "content":
                        user_prompt,
                },
            ]
        )


        # --------------------------------------------------
        # Parse response
        # --------------------------------------------------

        (
            predicate,
            description,
            strength,
            parsed_ok
        ) = _parse_single_record(
            _response_text(
                response
            )
        )


        return {

            "predicate":
                predicate,

            "description":
                description,

            "strength":
                strength,

            "status":
                (
                    "ok"
                    if parsed_ok
                    else
                    "parse_error"
                ),

            "sentence":
                sentence,
        }


    except Exception as e:

        return {

            "predicate":
                "related_to",

            "description":
                (
                    "[extraction failed: "
                    f"{type(e).__name__}: "
                    f"{str(e)[:300]}]"
                ),

            "strength":
                1,

            "status":
                "failed",

            "sentence":
                sentence,
        }


# ==========================================================
# 20. DISTRIBUTED WORKER
# ==========================================================

def process_partition_pandas(
    pdf_iterator
):

    import pandas as pd

    from concurrent.futures import (
        ThreadPoolExecutor
    )

    from langchain_openai import ChatOpenAI


    # ------------------------------------------------------
    # LLM client for this Spark partition
    # ------------------------------------------------------

    partition_llm = ChatOpenAI(

        model=
            _CONN["model"],

        base_url=
            _CONN["base_url"],

        api_key=
            _CONN["api_key"],

        temperature=
            0,

        max_retries=
            LLM_MAX_RETRIES,

        timeout=
            LLM_TIMEOUT_SECONDS,

        max_tokens=
            LLM_MAX_TOKENS,
    )


    # ------------------------------------------------------
    # Output columns
    # ------------------------------------------------------

    out_columns = [

        "source_node",

        "source_title",

        "predicate",

        "relationship_description",

        "relationship_strength",

        "target_title",

        "target_reference",

        "link_type",

        "status",

        "evidence_sentence",
    ]


    # ======================================================
    # PROCESS EACH ARROW BATCH
    # ======================================================

    for pdf in pdf_iterator:

        work = {}

        row_plan = []


        # ==================================================
        # DOCUMENT LOOP
        # ==================================================

        for _, row in pdf.iterrows():

            # Prepare document only once.

            doc = _prepare_document(
                row[
                    "content_with_titles"
                ]
            )


            # ==================================================
            # TARGET LOOP
            # ==================================================

            for entity in row[
                "entities"
            ]:

                target_title = (
                    entity[
                        "target_title"
                    ]
                )


                # One unique unit:
                #
                # source document + target title
                #
                # Same target appearing multiple times in one
                # document gets only ONE LLM call.

                key = (
                    row[
                        "source_node"
                    ],
                    target_title
                )


                if key not in work:

                    work[key] = (

                        row[
                            "source_title"
                        ],

                        doc,

                        target_title,
                    )


                row_plan.append(
                    (
                        row,
                        entity,
                        key
                    )
                )


        # ==================================================
        # RUN ONE LLM CALL PER TARGET
        #
        # Calls are parallel for speed, but each request
        # contains ONLY ONE target.
        # ==================================================

        def _run(key):

            (
                source_title,
                doc,
                target_title
            ) = work[key]

            return (
                key,
                _extract_one(
                    partition_llm,
                    source_title,
                    doc,
                    target_title
                )
            )


        with ThreadPoolExecutor(
            max_workers=
                LLM_THREADS_PER_PARTITION
        ) as pool:

            results = dict(
                pool.map(
                    _run,
                    list(
                        work.keys()
                    )
                )
            )


        # ==================================================
        # BUILD OUTPUT
        # ==================================================

        out_rows = []


        for (
            row,
            entity,
            key
        ) in row_plan:

            result = results[key]


            out_rows.append(
                {

                    # SOURCE = DOCUMENT TITLE
                    "source_node":
                        row[
                            "source_title"
                        ],

                    "source_title":
                        row[
                            "source_title"
                        ],

                    "predicate":
                        result[
                            "predicate"
                        ],

                    "relationship_description":
                        result[
                            "description"
                        ],

                    "relationship_strength":
                        result[
                            "strength"
                        ],

                    # TARGET = RESOLVED TARGET
                    "target_title":
                        entity[
                            "target_title"
                        ],

                    "target_reference":
                        entity[
                            "target_reference"
                        ],

                    "link_type":
                        entity[
                            "link_type"
                        ],

                    "status":
                        result[
                            "status"
                        ],

                    "evidence_sentence":
                        result[
                            "sentence"
                        ][
                            :MAX_EVIDENCE_CHARS
                        ],
                }
            )


        # --------------------------------------------------
        # Always yield matching schema
        # --------------------------------------------------

        yield pd.DataFrame(
            out_rows,
            columns=out_columns
        )


