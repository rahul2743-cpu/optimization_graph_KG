# ==========================================================

TUPLE_DELIM = "<|>"
RECORD_DELIM = "##"


# ==========================================================
# 4. SYSTEM PROMPT
# ==========================================================

SYSTEM_PROMPT = f"""
--- ROLE ---

You are an AI assistant extracting ONE semantic relationship
for a knowledge graph.


--- TASK ---

You are given:

1. SOURCE document title.
2. ONE TARGET entity.
3. The full sentence containing the target hyperlink.
4. A focused local context containing approximately
   6 words before and 6 words after the hyperlink.

Your task is to determine the ONE semantic relationship
between the SOURCE document and this ONE TARGET entity.


--- IMPORTANT ---

There is ONLY ONE target entity in this request.

Do NOT identify additional entities.

Do NOT create additional nodes.

Do NOT invent entities.

Do NOT create multiple predicates.

Return exactly ONE predicate.


--- SOURCE ---

The SOURCE is the document title.

The document title is already known.

Do not try to infer another source node such as:

- Artifact
- SME team
- Analysis
- Process
- System

Those are normal words in the sentence and are only
context for understanding the relationship.


--- TARGET ---

The TARGET is the entity explicitly provided to you.

Example:

TARGET:
MTCCM

The target is MTCCM.

Do not replace it with another entity.


--- CONTEXT ---

The FULL SENTENCE is the PRIMARY context.

The 6-word local context is an additional focused context.

Use the full sentence when it is necessary to understand
the relationship.

Do NOT blindly generate the predicate from only the
6-word context.


--- PREDICATE RULES ---

Generate exactly ONE semantic predicate.

The predicate must:

- be lowercase
- use snake_case
- contain 1 to 5 words
- contain no spaces
- contain no hyphens
- represent the actual relationship
- be grounded only in the supplied sentence/context

Examples:

owned_and_maintained_by
is_subject_to
depends_on
uses
opens
runs_in
controlled_by
belongs_to
supports
contains
is_related_to

If the relationship is genuinely unclear:

related_to


--- IMPORTANT ---

Do NOT create a predicate merely because the SOURCE and
TARGET appear in the same sentence.

The predicate must represent the semantic relationship.


--- STRENGTH ---

Return an integer from 1 to 10.

10 = very explicit relationship
8-9 = strong explicit relationship
5-7 = meaningful but less direct
3-4 = weak relationship
1-2 = very weak/incidental relationship


--- OUTPUT FORMAT ---

Return EXACTLY:

<Entity Name>{TUPLE_DELIM}<predicate>{TUPLE_DELIM}<description>{TUPLE_DELIM}<strength>{RECORD_DELIM}

No JSON.
No markdown.
No explanation outside the record.


--- EXAMPLE ---

SOURCE:
MTCCM Help: MTCCM.Run OpenTCCM

TARGET:
MTCCM

FULL SENTENCE:
Any changes made will be lost if <MTCCM> is uninstalled.

LOCAL CONTEXT:
changes made will be lost if <MTCCM> is uninstalled.

The predicate should describe the relationship expressed
by this sentence.

Example output format:

MTCCM{TUPLE_DELIM}<predicate>{TUPLE_DELIM}The sentence describes the effect of uninstalling MTCCM.{TUPLE_DELIM}8{RECORD_DELIM}
"""


# ==========================================================
# 5. UNRESOLVED DOCUMENT MARKUP
#
# These are things such as:
#
# <doc:wiki:Temp_Import....>
#
# They are NOT target entities for predicate extraction.
# ==========================================================

_UNRESOLVED_MARKUP_RE = re.compile(
    r"\[?<doc:(?:wiki:)?[^<>]+>\]?"
)


# ==========================================================
# 6. CLEAN TEXT
# ==========================================================

def _sanitize_for_llm(text):
    """
    Remove unresolved <doc:wiki:...> markup and
    normalize whitespace.
    """

    text = text or ""

    # Remove unresolved document references
    text = _UNRESOLVED_MARKUP_RE.sub(
        " ",
        text
    )

    # Normalize whitespace
    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


# ==========================================================
# 7. NORMALIZE PREDICATE
# ==========================================================

def _to_snake_case(s):
    """
    Convert LLM predicate into snake_case.
    """

    s = (s or "").strip().lower()

    s = re.sub(
        r"[^a-z0-9]+",
        "_",
        s
    )

    s = re.sub(
        r"_+",
        "_",
        s
    )

    s = s.strip("_")

    return s or "related_to"


# ==========================================================
# 8. SPLIT INTO SENTENCES
# ==========================================================

def _split_sentences(text):
    """
    Split text into sentences.

    The purpose is to find the sentence containing
    the target hyperlink.
    """

    text = text or ""

    text = re.sub(
        r"\s+",
        " ",
        text
    ).strip()

    if not text:
        return []

    sentences = re.split(
        r"(?<=[.!?])\s+",
        text
    )

    return [
        sentence.strip()
        for sentence in sentences
        if sentence.strip()
    ]


# ==========================================================
# 9. FIND SENTENCE CONTAINING TARGET
# ==========================================================

def _find_sentence_for_entity(
    text,
    entity_name
):
    """
    Find the sentence containing:

        <Entity Name>

    Example:

        Any changes made will be lost if <MTCCM> is uninstalled.
    """

    text = _sanitize_for_llm(text)

    sentences = _split_sentences(text)

    # ------------------------------------------------------
    # Exact target hyperlink
    # ------------------------------------------------------

    target_markup = (
        f"<{entity_name}>"
        .lower()
    )

    for sentence in sentences:

        if target_markup in sentence.lower():

            return sentence.strip()


    # ------------------------------------------------------
    # Fallback:
    # allow spaces inside < >
    #
    # Example:
    # < MTCCM >
    # ------------------------------------------------------

    pattern = re.compile(
        rf"<\s*{re.escape(entity_name)}\s*>",
        flags=re.IGNORECASE
    )

    for sentence in sentences:

        if pattern.search(sentence):

            return sentence.strip()


    # ------------------------------------------------------
    # Nothing found
    # ------------------------------------------------------

    return ""


# ==========================================================
# 10. EXTRACT LOCAL 6-WORD CONTEXT
# ==========================================================

def _extract_local_context(
    sentence,
    entity_name,
    window=6
):
    """
    Extract:

        6 words before
        +
        <Entity>
        +
        6 words after
    """

    if not sentence:
        return ""


    # ------------------------------------------------------
    # Find target hyperlink
    # ------------------------------------------------------

    pattern = re.compile(
        rf"<\s*{re.escape(entity_name)}\s*>",
        flags=re.IGNORECASE
    )

    match = pattern.search(sentence)

    if not match:

        return ""


    # ------------------------------------------------------
    # Text before target
    # ------------------------------------------------------

    before = sentence[
        :match.start()
    ].strip()


    # ------------------------------------------------------
    # Text after target
    # ------------------------------------------------------

    after = sentence[
        match.end():
    ].strip()


    # ------------------------------------------------------
    # Extract words
    # ------------------------------------------------------

    before_words = re.findall(
        r"\S+",
        before
    )

    after_words = re.findall(
        r"\S+",
        after
    )


    # Last 6 words before target
    before_words = before_words[-window:]


    # First 6 words after target
    after_words = after_words[:window]


    # Keep actual hyperlink
    hyperlink = match.group(0)


    # ------------------------------------------------------
    # Build context
    # ------------------------------------------------------

    local_context = (
        " ".join(before_words)
        + " "
        + hyperlink
        + " "
        + " ".join(after_words)
    )


    return re.sub(
        r"\s+",
        " ",
        local_context
    ).strip()


# ==========================================================
# 11. BUILD CONTEXT FOR ONE TARGET
# ==========================================================

def _build_entity_context(
    content,
    entity_name
):
    """
    For ONE target:

        document
            ↓
        find target
            ↓
        find sentence
            ↓
        get local context
    """

    # ------------------------------------------------------
    # Find full sentence
    # ------------------------------------------------------

    sentence = _find_sentence_for_entity(
        content,
        entity_name
    )


    # ------------------------------------------------------
    # Extract 6-word local context
    # ------------------------------------------------------

    local_context = _extract_local_context(
        sentence,
        entity_name,
        LOCAL_CONTEXT_WORDS
    )


    # ------------------------------------------------------
    # Limit extremely long sentence
    # ------------------------------------------------------

    if len(sentence) > MAX_SENTENCE_CHARS:

        sentence = (
            sentence[:MAX_SENTENCE_CHARS]
            + " ...[sentence truncated]"
        )


    return (
        sentence,
        local_context
    )


# ==========================================================
# 12. PARSE ONE LLM RESPONSE
# ==========================================================

def _parse_single_record(
    text,
    entity_name
):
    """
    Parse ONE LLM response.

    Expected:

    Entity
    <|>
    predicate
    <|>
    description
    <|>
    strength
    ##
    """

    if not text:

        return (
            "related_to",
            "",
            5
        )


    # ------------------------------------------------------
    # Get first record
    # ------------------------------------------------------

    record = (
        text
        .split(RECORD_DELIM)[0]
        .strip()
        .strip(",")
    )


    # ------------------------------------------------------
    # Split fields
    # ------------------------------------------------------

    parts = [
        p.strip()
        for p in record.split(
            TUPLE_DELIM
        )
    ]


    # ------------------------------------------------------
    # Validate response
    # ------------------------------------------------------

    if len(parts) < 3:

        return (
            "related_to",
            "",
            5
        )


    # ------------------------------------------------------
    # Predicate
    # ------------------------------------------------------

    predicate = _to_snake_case(
        parts[1]
    )


    # ------------------------------------------------------
    # Description
    # ------------------------------------------------------

    description = parts[2]


    # ------------------------------------------------------
    # Strength
    # ------------------------------------------------------

    try:

        strength_text = (
            parts[3]
            if len(parts) > 3
            else "5"
        )

        numbers = re.sub(
            r"\D",
            "",
            strength_text
        )

        strength = int(
            numbers
        )

        strength = max(
            1,
            min(
                10,
                strength
            )
        )

    except (
        ValueError,
        TypeError
    ):

        strength = 5


    return (
        predicate,
        description,
        strength
    )


# ==========================================================
# 13. DISTRIBUTED WORKER
# ==========================================================

def process_partition_pandas(
    pdf_iterator
):

    import pandas as pd

    from langchain_openai import ChatOpenAI


    # ======================================================
    # CREATE LLM CLIENT
    # ======================================================

    partition_llm = ChatOpenAI(
        model=_CONN["model"],
        base_url=_CONN["base_url"],
        api_key=_CONN["api_key"],
        temperature=0,
    )


    # ======================================================
    # OUTPUT COLUMNS
    # ======================================================

    out_columns = [
        "source_node",
        "source_title",
        "predicate",
        "relationship_description",
        "relationship_strength",
        "target_title",
        "target_reference",
        "link_type",
    ]


    # ======================================================
    # PROCESS BATCHES
    # ======================================================

    for pdf in pdf_iterator:

        out_rows = []


        # ==================================================
        # LOOP 1:
        # DOCUMENT BY DOCUMENT
        # ==================================================

        for _, row in pdf.iterrows():

            entities = row["entities"]


            # ==================================================
            # LOOP 2:
            # ONE TARGET AT A TIME
            # ==================================================
            #
            # THIS IS THE IMPORTANT LOOP.
            #
            # One target:
            #
            #   target
            #      ↓
            #   sentence
            #      ↓
            #   local context
            #      ↓
            #   ONE LLM CALL
            #      ↓
            #   ONE predicate
            #
            # ==================================================

            for entity in entities:

                target_title = (
                    entity["target_title"]
                )


                try:

                    # ==========================================
                    # STEP 1:
                    # SOURCE = DOCUMENT TITLE
                    # ==========================================

                    source_title = (
                        row["source_title"]
                    )


                    # ==========================================
                    # STEP 2:
                    # FIND SENTENCE
                    # ==========================================

                    sentence, local_context = (
                        _build_entity_context(
                            row["content_with_titles"],
                            target_title
                        )
                    )


                    # ==========================================
                    # STEP 3:
                    # IF NO SENTENCE FOUND
                    # ==========================================

                    if not sentence:

                        predicate = "related_to"

                        description = (
                            "[No sentence containing "
                            "target hyperlink was found]"
                        )

                        strength = 1


                    else:

                        # ======================================
                        # STEP 4:
                        # BUILD PROMPT FOR ONE TARGET ONLY
                        # ======================================

                        user_prompt = f"""
SOURCE DOCUMENT TITLE:
{source_title}


TARGET ENTITY:
{target_title}


FULL SENTENCE CONTAINING THE TARGET:
{sentence}


FOCUSED LOCAL CONTEXT:
{local_context}


TASK:

Determine the ONE semantic relationship between:

SOURCE:
{source_title}

TARGET:
{target_title}

Use the full sentence as the primary context.

Use the local context as additional focused context.

Return exactly ONE predicate.
"""


                        # ======================================
                        # STEP 5:
                        # ONE LLM CALL
                        # ======================================

                        resp = partition_llm.invoke(
                            [
                                {
                                    "role": "system",
                                    "content": SYSTEM_PROMPT,
                                },
                                {
                                    "role": "user",
                                    "content": user_prompt,
                                },
                            ]
                        )


                        # ======================================
                        # STEP 6:
                        # PARSE ONE PREDICATE
                        # ======================================

                        (
                            predicate,
                            description,
                            strength
                        ) = _parse_single_record(
                            resp.content.strip(),
                            target_title
                        )


                except Exception as e:

                    # ==========================================
                    # ONE FAILED TARGET DOES NOT KILL DOCUMENT
                    # ==========================================

                    predicate = "related_to"

                    description = (
                        f"[extraction failed: {e}]"
                    )

                    strength = 1


                # ==================================================
                # STEP 7:
                # CREATE ONE RDF RELATIONSHIP ROW
                # ==================================================

                out_rows.append(
                    {

                        # IMPORTANT:
                        # Source node is document TITLE
                        "source_node": row[
                            "source_title"
                        ],

                        "source_title": row[
                            "source_title"
                        ],

                        "predicate": predicate,

                        "relationship_description":
                            description,

                        "relationship_strength":
                            strength,

                        # Target node
                        "target_title":
                            entity[
                                "target_title"
                            ],

                        "target_reference":
                            entity[
                                "target_reference"
                            ],

                        "link_type":
                            entity[
                                "link_type"
                            ],
                    }
                )


        # ==================================================
        # RETURN BATCH
        # ==================================================

        yield pd.DataFrame(
            out_rows,
            columns=out_columns
        )


# ==========================================================
# 14. OUTPUT SCHEMA
# ==========================================================

TRIPLES_SCHEMA = StructType([

    StructField(
        "source_node",
        StringType()
    ),

    StructField(
        "source_title",
        StringType()
    ),

    StructField(
        "predicate",
        StringType()
    ),

    StructField(
        "relationship_description",
        StringType()
    ),

    StructField(
        "relationship_strength",
        IntegerType()
    ),

    StructField(
        "target_title",
        StringType()
    ),

    StructField(
        "target_reference",
        StringType()
    ),

    StructField(
        "link_type",
        StringType()
    ),
])


# ==========================================================
# 15. GET RESOLVED TARGETS
# ==========================================================
#
# IMPORTANT:
#
# Only is_resolved=True targets enter this pipeline.
#
# Therefore:
#
# <doc:wiki:...>
#
# will NOT become a target unless your previous cells
# explicitly resolved it into target_title.
#
# ==========================================================

distinct_targets = (

    sentences_df

    .filter(
        F.col("is_resolved")
    )

    .select(
        "source_node",
        "source_title",
        "target_reference",
        "target_title",
        "link_type"
    )

    .distinct()
)


# ==========================================================
# 16. GROUP TARGETS BY DOCUMENT
# ==========================================================
#
# IMPORTANT:
#
# This GROUPING does NOT mean one LLM call.
#
# It only organizes targets under their source document.
#
# The actual LLM calls happen later inside:
#
#     for entity in entities:
#
# ==========================================================

doc_entities = (

    distinct_targets

    .groupBy(
        "source_node",
        "source_title"
    )

    .agg(
        F.collect_list(
            F.struct(
                "target_title",
                "target_reference",
                "link_type"
            )
        ).alias("entities")
    )
)


