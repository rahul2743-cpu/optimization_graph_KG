# ==========================================================
# Cell 10 : LLM RELATIONSHIP EXTRACTION  -- TOKEN-LIGHT VERSION
#
#   OLD: send the FULL document (up to 12,000 chars) to the LLM once
#        per document, ask for every linked entity.
#   NEW: send ONLY the COMPLETE SENTENCE the <link> sits in (default).
#        Short sentence (heading, bullet)? The neighbouring sentence is
#        added until there is enough to read. Raw "6 words before/after"
#        is still available as CONTEXT_MODE = "window", but it can cut
#        a sentence in half, so it is NOT the default any more.
#        The LLM gets BOTH node names (SOURCE document + TARGET entity)
#        and must return a meaningful predicate that reads as a true
#        statement:   SOURCE --predicate--> TARGET
#        plus a one-sentence description and a strength.
#        Output columns are the SAME as before, so Cell 11 / 12 / 13
#        keep working without changes.
#
#   Where the token savings come from
#     1. Only a short snippet per link goes to the LLM, not the document.
#     2. Up to LINKS_PER_CALL snippets of one document share ONE call,
#        so the instruction prompt is paid once per batch, not per link.
#     3. Short answers (one-sentence description, max ~20 words).
#     4. No second pass: the old cell ran .count() on the un-cached
#        result AFTER .write(), which re-ran every LLM call a second
#        time. This version counts from the checkpoint table instead.
#
#   Scale / safety (kept from the old version)
#     - mapInPandas (serverless-safe), N_PARTITIONS parallel workers
#     - CHECKPOINT: documents are processed in chunks, and each chunk is
#       appended to the Delta table when it finishes. Re-running the cell
#       skips every link already saved (keyed on link_uid).
#     - A failed / unparseable batch is NOT saved, so the next run
#       retries it (the old version saved a fake "related_to" row and
#       never retried).
#
#   Needs: sentences_df (Cell 8b), document_rendered_df (Cell 8d),
#          DEPLOYMENT_NAME + DATABRICKS_TOKEN (Cell 9)
# ==========================================================
import re
import math
from pyspark.sql import functions as F
from pyspark.sql.types import StructType, StructField, StringType, IntegerType

print("=" * 80)
print("CELL 10 — LLM RELATIONSHIP EXTRACTION (token-light, per-link context)")
print("=" * 80)

# ---- Knobs ----------------------------------------------------------------
CONTEXT_MODE       = "sentence" # "sentence" = full sentence around the <link>  (recommended)
                                 # "window"   = raw N words each side (may cut a sentence)
MIN_SENTENCE_WORDS = 10         # sentence shorter than this? add the neighbouring sentence(s)
SENTENCE_MAX_WORDS = 60         # safety cap per side, so one endless sentence can't blow up tokens
WINDOW_WORDS       = 6          # only used when CONTEXT_MODE = "window"
LINKS_PER_CALL     = 25         # snippets of ONE document per LLM call
N_PARTITIONS       = 40         # parallel workers (raise toward your endpoint limit)
DOCS_PER_CHUNK     = 2000       # a checkpoint is written after every chunk of docs
DRY_RUN            = False      # True = only PRINT sample contexts, no LLM calls

# NEW table name on purpose: the old checkpoint holds one row per DOCUMENT,
# this one holds one row per LINK. Mixing them would skip the wrong things.
CHECKPOINT_TABLE = "knwbt_airr_foundry_dev_catalog.secured.kg_relationship_checkpoint_ctx"

assert CONTEXT_MODE in ("window", "sentence"), "CONTEXT_MODE must be 'window' or 'sentence'"

# ---- Connection config (plain values, NOT the llm client object) ---------
_CONN = {
    "model": DEPLOYMENT_NAME,
    "base_url": "https://adb-3955688708870984.4.azuredatabricks.net/serving-endpoints",
    "api_key": DATABRICKS_TOKEN,
}

TUPLE_DELIM  = "<|>"
RECORD_DELIM = "##"

SYSTEM_PROMPT = f"""You label relationships for a knowledge graph.

You get a SOURCE document title and numbered items. Each item has a TARGET entity
and a TEXT sentence from the SOURCE document where the TARGET appears (marked <Like This>).
The graph edge is:   SOURCE --predicate--> TARGET
Choose the predicate that makes this a TRUE, natural statement, using ONLY what the TEXT says.
Do not rename or invent entities.

Answer with one record per item, in the same order, formatted exactly as:
NUMBER{TUPLE_DELIM}PREDICATE{TUPLE_DELIM}DESCRIPTION{TUPLE_DELIM}STRENGTH{RECORD_DELIM}

- PREDICATE: snake_case verb phrase, 2-5 words, saying what the SOURCE does with / to / for
  the TARGET, e.g. defines_fluid_system_of, is_subject_to, depends_on, is_controlled_by.
  Be specific. NEVER use vague labels like related_to, is_related_to, mentions, references, has_link.
- DESCRIPTION: ONE complete sentence (max 25 words) stating why SOURCE and TARGET are connected.
- STRENGTH: integer 1-10 (10 = central and explicit, 1 = passing mention)

Example, for SOURCE "Fluid System Definition Process":
1{TUPLE_DELIM}defines_fluid_system_of{TUPLE_DELIM}The process is a sub-set of the workflow that defines the fluid system of the Gas Turbine.{TUPLE_DELIM}8{RECORD_DELIM}

No JSON, no markdown, no text outside the records."""


# ==========================================================
# Helpers (pure Python -- run on the executors)
# ==========================================================
_UNRESOLVED_MARKUP_RE = re.compile(r"\[?<doc:(?:wiki:)?[^<>]+>\]?")

# one regex that finds EVERY link in content_with_titles, in document order:
#   alt 1: unresolved raw link   [label <doc:wiki:Ref>]   (label optional)
#   alt 2: resolved link         <Some Title>
# Each link becomes exactly one match, so match number k == Cell 8b's `occurrence` k.
_LINK_OR_TITLE_RE = re.compile(
    r"\[(?:(?P<label>[^<>\[\]]+?)\s+)?<doc:(?:wiki:)?[^>]+>\]"
    r"|<(?P<title>[^<>]+)>"
)
_SENTINEL_RE = re.compile(r"\ue000(\d+)\ue001")
_LEFT_END    = re.compile(r"[.!?;:]$")   # a word ending like this closes the previous sentence
_RIGHT_END   = re.compile(r"[.!?;]$")    # a word ending like this closes the current sentence


def _sanitize_for_llm(text):
    return re.sub(r"\s+", " ", _UNRESOLVED_MARKUP_RE.sub(" ", text)).strip()


def _to_snake_case(s):
    s = s.strip().lower()
    s = re.sub(r"[^a-z0-9]+", "_", s)
    s = re.sub(r"_+", "_", s).strip("_")
    return s or "related_to"


def _tokenize_doc(text):
    """Split the document into words. Every link (resolved or not) is
    swapped for ONE private sentinel token first, so:
      - a link counts as a single word, whatever its title length
      - the '.' inside a reference id can never look like a sentence end
    `display[k]` = the text to show for link k (title, or label if unresolved)."""
    display = []

    def repl(m):
        title = m.group("title")
        display.append(title if title is not None else (m.group("label") or ""))
        return f"\ue000{len(display) - 1}\ue001"

    return _LINK_OR_TITLE_RE.sub(repl, text).split(), display


def _render_words(words, display, target):
    """Words -> text. The TARGET link keeps its <angle brackets>; every other
    link is shown as plain text so the LLM sees exactly ONE marked entity."""
    def sub(m):
        k = int(m.group(1))
        return f"<{display[k]}>" if k == target else display[k]
    return re.sub(r"\s+", " ", " ".join(_SENTINEL_RE.sub(sub, w) for w in words)).strip()


def _fallback_context(sentence, title):
    """Used only if a link can't be located in the full text: fall back to the
    sentence from Cell 8b, trimmed to ~200 chars each side of the link."""
    s = _sanitize_for_llm(sentence or "")
    marker = f"<{title}>"
    k = s.find(marker)
    if k < 0:
        return marker
    return s[max(0, k - 200): k + len(marker) + 200]


def _left_bound(words, i):
    """Index of the first word of the sentence that contains word i."""
    lo = i
    while lo > 0 and i - lo < SENTENCE_MAX_WORDS and not _LEFT_END.search(words[lo - 1]):
        lo -= 1
    return lo


def _right_bound(words, i):
    """Index just AFTER the last word of the sentence that contains word i."""
    hi = i
    while hi < len(words) - 1 and hi - i < SENTENCE_MAX_WORDS and not _RIGHT_END.search(words[hi]):
        hi += 1
    return hi + 1


def _contexts_for_doc(doc_text, items):
    """One short, readable context string per item (item = one link occurrence)."""
    words, display = _tokenize_doc(doc_text or "")

    pos = {}                                   # link number -> index of its word
    for w_idx, w in enumerate(words):
        for m in _SENTINEL_RE.finditer(w):
            pos.setdefault(int(m.group(1)), w_idx)

    out = []
    for it in items:
        occ, title = it["occurrence"], it["target_title"]

        # guard: link #occ must exist AND carry the expected title, else fall back
        if occ is None or occ not in pos or display[occ] != title:
            out.append(_fallback_context(it["sentence"], title))
            continue

        i = pos[occ]
        if CONTEXT_MODE == "sentence":
            lo, hi = _left_bound(words, i), _right_bound(words, i)
            # very short "sentence" (heading, bullet, fragment)? borrow the
            # neighbouring sentence on each side so the LLM has something to read
            if hi - lo < MIN_SENTENCE_WORDS:
                if lo > 0:
                    lo = _left_bound(words, lo - 1)
                if hi < len(words):
                    hi = _right_bound(words, hi)
            text = _render_words(words[lo:hi], display, occ)
        else:  # window
            lo = max(0, i - WINDOW_WORDS)
            hi = min(len(words), i + WINDOW_WORDS + 1)
            text = _render_words(words[lo:hi], display, occ)
            if lo > 0:
                text = "... " + text
            if hi < len(words):
                text = text + " ..."
        out.append(text)
    return out


def _parse_batch(text, n_items):
    """LLM answer -> {0-based item index: (predicate, description, strength)}.
    Matched by the NUMBER the LLM echoes back, so a missing or reordered
    record can never shift results onto the wrong link."""
    found = {}
    for record in text.split(RECORD_DELIM):
        parts = [p.strip() for p in record.strip().strip(",").split(TUPLE_DELIM)]
        if len(parts) < 3:
            continue
        digits = re.search(r"\d+", parts[0])
        if not digits:
            continue
        k = int(digits.group()) - 1
        if not 0 <= k < n_items:
            continue

        predicate = _to_snake_case(parts[1])
        if len(parts) >= 4:
            description = TUPLE_DELIM.join(parts[2:-1])
            strength_txt = parts[-1]
        else:
            description, strength_txt = parts[2], ""
        num = re.search(r"\d+", strength_txt)
        strength = max(1, min(10, int(num.group()))) if num else 5
        found[k] = (predicate, description, strength)
    return found


OUT_COLUMNS = [
    "link_uid", "source_node", "source_title", "predicate",
    "relationship_description", "relationship_strength",
    "target_title", "target_reference", "link_type", "context_used",
]


# ---- The distributed worker: runs on an executor, once per partition ------
def process_partition_pandas(pdf_iterator):
    import pandas as pd
    from langchain_openai import ChatOpenAI

    partition_llm = ChatOpenAI(
        model=_CONN["model"], base_url=_CONN["base_url"],
        api_key=_CONN["api_key"], temperature=0,
        max_retries=3, timeout=120,
    )

    for pdf in pdf_iterator:
        out_rows = []

        for _, row in pdf.iterrows():
            items = list(row["items"])
            contexts = _contexts_for_doc(row["content_with_titles"], items)

            for start in range(0, len(items), LINKS_PER_CALL):
                b_items = items[start:start + LINKS_PER_CALL]
                b_ctx = contexts[start:start + LINKS_PER_CALL]

                numbered = "\n".join(
                    f"{n}. TARGET: {it['target_title']}\n   TEXT: {c}"
                    for n, (it, c) in enumerate(zip(b_items, b_ctx), 1)
                )
                user_prompt = (
                    f"SOURCE: {row['source_title']}\n\n"
                    f"Items:\n{numbered}"
                )

                try:
                    resp = partition_llm.invoke([
                        {"role": "system", "content": SYSTEM_PROMPT},
                        {"role": "user", "content": user_prompt},
                    ])
                    content = resp.content if isinstance(resp.content, str) else str(resp.content)
                    found = _parse_batch(content, len(b_items))
                except Exception as e:
                    # Bad batch -> log and move on. Nothing is saved for these
                    # links, so the NEXT run of this cell retries them.
                    print(f"[batch failed] {row['source_title']!r}: {e}")
                    continue

                for k, it in enumerate(b_items):
                    if k not in found:
                        continue          # LLM skipped this one -> retried next run
                    predicate, description, strength = found[k]
                    out_rows.append({
                        "link_uid": it["link_uid"],
                        "source_node": row["source_node"],
                        "source_title": row["source_title"],
                        "predicate": predicate,
                        "relationship_description": description,
                        "relationship_strength": strength,
                        "target_title": it["target_title"],
                        "target_reference": it["target_reference"],
                        "link_type": it["link_type"],
                        "context_used": b_ctx[k],
                    })

        # ALWAYS yield the right columns, even when empty (mapInPandas needs it)
        yield pd.DataFrame(out_rows, columns=OUT_COLUMNS)


TRIPLES_SCHEMA = StructType([
    StructField("link_uid", StringType()),
    StructField("source_node", StringType()),
    StructField("source_title", StringType()),
    StructField("predicate", StringType()),
    StructField("relationship_description", StringType()),
    StructField("relationship_strength", IntegerType()),
    StructField("target_title", StringType()),
    StructField("target_reference", StringType()),
    StructField("link_type", StringType()),
    StructField("context_used", StringType()),
])


# ==========================================================
# Spark side
# ==========================================================
# ---- Step 1: one row per resolved link occurrence (from Cell 8b) ----------
link_inputs = (
    sentences_df
    .filter(F.col("is_resolved"))
    .select("link_uid", "source_node", "source_title", "occurrence",
            "target_reference", "target_title", "link_type", "sentence")
)

# ---- Step 2: skip links already checkpointed (resumable) ------------------
table_exists = spark.catalog.tableExists(CHECKPOINT_TABLE)
if table_exists:
    already_done = spark.table(CHECKPOINT_TABLE).select("link_uid").distinct()
    print(f"Already checkpointed (skipped) : {already_done.count()} links")
    link_inputs = link_inputs.join(already_done, on="link_uid", how="left_anti")
else:
    print(f"No checkpoint table yet -- starting fresh at {CHECKPOINT_TABLE}")

n_links_todo = link_inputs.count()
print(f"Links to process this run      : {n_links_todo}")

# ---- Step 3: group the links of each document (contexts are built per doc) -
doc_batches = (
    link_inputs
    .groupBy("source_node", "source_title")
    .agg(F.collect_list(F.struct(
        "link_uid", "occurrence", "target_title",
        "target_reference", "link_type", "sentence"
    )).alias("items"))
    .join(
        document_rendered_df.select("source_node", "content_with_titles"),
        on="source_node", how="inner"
    )
)

if n_links_todo == 0:
    print("Nothing to do -- all links already checkpointed.")
else:
    n_docs = doc_batches.count()
    print(f"Documents involved             : {n_docs}")

    # ---- Step 4: PREVIEW real contexts + rough token estimate (no LLM) ------
    print()
    print(f"CONTEXT_MODE = {CONTEXT_MODE!r}"
          + (f"  ({WINDOW_WORDS} words each side)" if CONTEXT_MODE == "window"
             else f"  (full sentence, min {MIN_SENTENCE_WORDS} words)"))
    print("Sample contexts (what the LLM will actually see):")
    print("-" * 80)
    sample_docs = doc_batches.limit(5).collect()
    shown = n_ctx = ctx_chars = old_chars = new_chars_overhead = 0
    for d in sample_docs:
        ctxs = _contexts_for_doc(d["content_with_titles"], d["items"])
        old_chars += min(len(d["content_with_titles"] or ""), 12000)
        new_chars_overhead += math.ceil(len(d["items"]) / LINKS_PER_CALL) * len(SYSTEM_PROMPT)
        for it, c in zip(d["items"], ctxs):
            n_ctx += 1
            ctx_chars += len(c) + len(it['target_title']) + 20   # numbering + TARGET/TEXT labels
            if shown < 10:
                print(f"[{d['source_title'][:40]}]  target = {it['target_title']}")
                print(f"    {c}")
                shown += 1
    print("-" * 80)
    if n_ctx:
        new_est = (ctx_chars + new_chars_overhead) // 4      # ~4 chars per token
        old_est = (old_chars + len(sample_docs) * 2000) // 4  # old prompt was ~2000 chars
        print(f"Rough INPUT tokens for these {len(sample_docs)} sample docs "
              f"({n_ctx} links):  old design ~ {old_est:,}   new design ~ {new_est:,}")
    print()

    if DRY_RUN:
        print("DRY_RUN = True -> stopping before any LLM call.")
    else:
        # ---- Step 5: distributed extraction, checkpointed chunk by chunk ----
        n_before = spark.table(CHECKPOINT_TABLE).count() if table_exists else 0
        n_chunks = max(1, math.ceil(n_docs / DOCS_PER_CHUNK))
        doc_batches = doc_batches.withColumn(
            "_chunk", F.pmod(F.xxhash64("source_node"), F.lit(n_chunks))
        )

        for c in range(n_chunks):
            (
                doc_batches
                .filter(F.col("_chunk") == c)
                .drop("_chunk")
                .repartition(N_PARTITIONS)
                .mapInPandas(process_partition_pandas, schema=TRIPLES_SCHEMA)
                .write.mode("append")
                .option("mergeSchema", "true")
                .saveAsTable(CHECKPOINT_TABLE)
            )
            print(f"  chunk {c + 1}/{n_chunks} checkpointed")

        # count from the TABLE -- never re-run the LLM job just to count it
        n_new = spark.table(CHECKPOINT_TABLE).count() - n_before
        print()
        print(f"Relationships extracted this run : {n_new} of {n_links_todo} links")
        if n_new < n_links_todo:
            print(f"  {n_links_todo - n_new} link(s) failed or were skipped by the LLM "
                  f"-- just re-run this cell to retry only those.")
        print(f"Checkpointed to                  : {CHECKPOINT_TABLE}")

# ---- Step 6: triples_df = the FULL accumulated result (Cell 11 reads this) --
if spark.catalog.tableExists(CHECKPOINT_TABLE):
    # NOTE: no .cache() here -- serverless compute does not support it
    # ([NOT_SUPPORTED_WITH_SERVERLESS] PERSIST TABLE). Reading the Delta
    # table again is cheap and never calls the LLM.
    triples_df = spark.table(CHECKPOINT_TABLE)
    n_total = triples_df.count()
    print()
    print(f"triples_df (all runs combined) row count : {n_total}")
    print()
    print("Sample triples (source_title --[predicate, strength]--> target_title):")
    display(triples_df.select(
        "source_title", "predicate", "relationship_strength",
        "target_title", "relationship_description", "context_used", "link_type"
    ))
