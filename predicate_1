# ==========================================================
# 6. UNRESOLVED MARKUP
# ==========================================================

# Raw unresolved markup such as:
#
# <doc:wiki:SomePage>
#
# must never become a target.
#
# Cell 8b already determines whether a hyperlink is resolved.
# This regex is additionally used when preparing sentence text.

_UNRESOLVED_MARKUP_RE = re.compile(
    r"\[?<doc:(?:wiki:)?[^<>]+>\]?"
)


# ==========================================================
# 7. LINK MASKING
#
# Prevent a period inside a hyperlink such as:
#
# <MTCCM.Run>
#
# from being interpreted as a sentence boundary.
# ==========================================================

_LINK_RE = re.compile(
    r"<[^<>]+>"
)


# ==========================================================
# 8. CLEAN TEXT
# ==========================================================

def _sanitize_text(text):

    text = (
        text
        or
        ""
    )

    text = _UNRESOLVED_MARKUP_RE.sub(
        " ",
        text
    )

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


# ==========================================================
# 9. TARGET PATTERN
# ==========================================================

def _target_pattern(
    target_title
):

    words = (
        target_title
        or
        ""
    ).split()

    if not words:

        return None

    return re.compile(
        r"<\s*"
        +
        r"\s+".join(
            re.escape(word)
            for word in words
        )
        +
        r"\s*>",
        flags=re.IGNORECASE,
    )


# ==========================================================
# 10. PREPARE DOCUMENT
# ==========================================================

def _prepare_document(
    content
):

    text = _sanitize_text(
        content
    )

    # Mask all hyperlink contents.
    #
    # Example:
    #
    # <MTCCM.Run>
    #
    # becomes a same-length masked string.
    #
    # This allows sentence boundary detection without
    # accidentally splitting inside hyperlinks.

    masked = _LINK_RE.sub(
        lambda m:
            "x" * len(
                m.group(0)
            ),
        text
    )

    return (
        text,
        masked,
    )


# ==========================================================
# 11. FIND SENTENCE FOR ONE TARGET
# ==========================================================

def _find_sentence_for_target(
    prepared_document,
    target_title
):

    text, masked = prepared_document

    if not text:

        return ""


    pattern = _target_pattern(
        target_title
    )

    if pattern is None:

        return ""


    target_match = pattern.search(
        text
    )

    if not target_match:

        return ""


    target_start = (
        target_match.start()
    )

    target_end = (
        target_match.end()
    )


    # ------------------------------------------------------
    # Find previous sentence boundary
    # ------------------------------------------------------

    sentence_start = 0

    for i in range(
        target_start - 1,
        -1,
        -1
    ):

        if (
            masked[i]
            in
            ".!?"
        ):

            sentence_start = (
                i + 1
            )

            break


    # ------------------------------------------------------
    # Find next sentence boundary
    # ------------------------------------------------------

    sentence_end = len(
        text
    )

    for i in range(
        target_end,
        len(text)
    ):

        if (
            masked[i]
            in
            ".!?"
        ):

            sentence_end = (
                i + 1
            )

            break


    sentence = text[
        sentence_start:
        sentence_end
    ].strip()


    return sentence


# ==========================================================
# 12. EXTRACT SIX-WORD LOCAL CONTEXT
# ==========================================================

def _extract_local_context(
    sentence,
    target_title
):

    if not sentence:

        return ""


    pattern = _target_pattern(
        target_title
    )

    if pattern is None:

        return ""


    match = pattern.search(
        sentence
    )

    if not match:

        return ""


    before_words = (
        sentence[
            :match.start()
        ]
        .split()
        [-LOCAL_CONTEXT_WORDS:]
    )


    after_words = (
        sentence[
            match.end():
        ]
        .split()
        [:LOCAL_CONTEXT_WORDS]
    )


    target_text = (
        match.group(0)
    )


    return " ".join(
        before_words
        +
        [target_text]
        +
        after_words
    )


# ==========================================================
# 13. BUILD ONE TARGET'S CONTEXT
# ==========================================================

def _build_target_context(
    prepared_document,
    target_title
):

    sentence = _find_sentence_for_target(
        prepared_document,
        target_title
    )

    if not sentence:

        return (
            "",
            "",
        )


    local_context = (
        _extract_local_context(
            sentence,
            target_title
        )
    )


    # Keep the target inside the sentence if sentence is
    # extremely large.

    if len(sentence) > MAX_SENTENCE_CHARS:

        pattern = _target_pattern(
            target_title
        )

        match = (
            pattern.search(
                sentence
            )
            if pattern
            else
            None
        )


        if match:

            center = (
                match.start()
            )

            half = (
                MAX_SENTENCE_CHARS
                //
                2
            )

            start = max(
                0,
                center - half
            )

            end = min(
                len(sentence),
                start + MAX_SENTENCE_CHARS
            )

            sentence = (
                sentence[start:end]
            )

        else:

            sentence = (
                sentence[
                    :MAX_SENTENCE_CHARS
                ]
            )


    return (
        sentence,
        local_context,
    )


# ==========================================================
# 14. NORMALIZE PREDICATE
# ==========================================================

_PREDICATE_ALIASES = {

    "is_related_to":
        "related_to",

    "relates_to":
        "related_to",

    "refers_to":
        "mentions",

    "references":
        "mentions",

    "utilizes":
        "uses",

    "utilises":
        "uses",

    "relies_on":
        "depends_on",

    "is_dependent_on":
        "depends_on",
}


def _normalize_predicate(
    predicate
):

    predicate = (
        predicate
        or
        ""
    ).strip().lower()


    predicate = re.sub(
        r"[^a-z0-9]+",
        "_",
        predicate
    )


    predicate = re.sub(
        r"_+",
        "_",
        predicate
    )


    predicate = predicate.strip(
        "_"
    )


    predicate = (
        predicate
        or
        "related_to"
    )


    predicate = (
        _PREDICATE_ALIASES.get(
            predicate,
            predicate
        )
    )


    # Maximum 5 words.
    words = predicate.split(
        "_"
    )

    if len(words) > 5:

        predicate = "_".join(
            words[:5]
        )


    return (
        predicate
        or
        "related_to"
    )


# ==========================================================
# 15. PARSE ONE LLM RESPONSE
# ==========================================================

def _parse_llm_response(
    response_text
):

    if not response_text:

        return (
            "related_to",
            "",
            1,
            "parse_error",
        )


    # Only one record is expected.
    record = (
        response_text
        .split(
            RECORD_DELIM
        )[0]
        .strip()
    )


    parts = [
        part.strip()
        for part
        in record.split(
            TUPLE_DELIM
        )
    ]


    if len(parts) < 3:

        return (
            "related_to",
            (
                "[Unparseable LLM response: "
                f"{response_text[:300]}]"
            ),
            1,
            "parse_error",
        )


    predicate = _normalize_predicate(
        parts[1]
    )


    description = (
        parts[2]
        if len(parts) >= 3
        else ""
    )


    strength = 5


    if len(parts) >= 4:

        try:

            number = re.search(
                r"\d+",
                parts[3]
            )

            if number:

                strength = max(
                    1,
                    min(
                        10,
                        int(
                            number.group()
                        )
                    )
                )

        except Exception:

            strength = 5


    return (
        predicate,
        description,
        strength,
        "ok",
    )


# ==========================================================
# 16. EXTRACT ONE TARGET
#
# THIS IS THE CORE FUNCTION.
#
# ONE TARGET
#     |
#     +-- find sentence
#     |
#     +-- create 6-word context
#     |
#     +-- ONE LLM CALL
#     |
#     +-- ONE predicate
#
# ==========================================================

def _extract_one_target(
    llm,
    source_title,
    prepared_document,
    target_title
):

    sentence, local_context = (
        _build_target_context(
            prepared_document,
            target_title
        )
    )


    # ------------------------------------------------------
    # Sentence not found
    # ------------------------------------------------------

    if not sentence:

        return {

            "predicate":
                "related_to",

            "description":
                (
                    "[No sentence containing "
                    "target hyperlink was found]"
                ),

            "strength":
                1,

            "status":
                "no_sentence",

            "evidence_sentence":
                "",
        }


    # ------------------------------------------------------
    # ONE TARGET PROMPT
    # ------------------------------------------------------

    user_prompt = f"""
SOURCE DOCUMENT TITLE:
{source_title}


TARGET ENTITY:
{target_title}


FULL SENTENCE CONTAINING THE TARGET:
{sentence}


FOCUSED LOCAL CONTEXT:
{local_context}


TASK:

Determine the ONE semantic relationship between:

SOURCE:
{source_title}

TARGET:
{target_title}

The SOURCE is the subject.

The TARGET is the object.

Use the full sentence as the primary evidence.

Use the local context as additional focused evidence.

Return exactly ONE predicate.
"""


    # ------------------------------------------------------
    # ONE LLM CALL
    #
    # Retry means retrying the SAME target.
    # We never add another target to this request.
    # ------------------------------------------------------

    last_error = None


    for attempt in range(
        1,
        LLM_MAX_RETRIES + 1
    ):

        try:

            response = llm.invoke(
                [
                    {
                        "role":
                            "system",

                        "content":
                            SYSTEM_PROMPT,
                    },

                    {
                        "role":
                            "user",

                        "content":
                            user_prompt,
                    },
                ]
            )


            response_text = (
                getattr(
                    response,
                    "content",
                    ""
                )
                or
                ""
            )


            (
                predicate,
                description,
                strength,
                status,
            ) = _parse_llm_response(
                response_text
            )


            return {

                "predicate":
                    predicate,

                "description":
                    description,

                "strength":
                    strength,

                "status":
                    status,

                "evidence_sentence":
                    sentence[
                        :MAX_EVIDENCE_CHARS
                    ],
            }


        except Exception as e:

            last_error = e


            if attempt < LLM_MAX_RETRIES:

                time.sleep(
                    RETRY_SLEEP_SECONDS
                    *
                    attempt
                )


    # ------------------------------------------------------
    # All retries failed
    # ------------------------------------------------------

    return {

        "predicate":
            "related_to",

        "description":
            (
                "[extraction failed: "
                f"{type(last_error).__name__}: "
                f"{str(last_error)[:300]}]"
            ),

        "strength":
            1,

        "status":
            "failed",

        "evidence_sentence":
            sentence[
                :MAX_EVIDENCE_CHARS
            ],
    }


