# ==========================================================
# 25. GET RESOLVED TARGETS
# ==========================================================

print()
print("=" * 80)
print("GETTING RESOLVED TARGETS")
print("=" * 80)


distinct_targets = (

    sentences_df

    # ------------------------------------------------------
    # ONLY RESOLVED TARGETS
    # ------------------------------------------------------

    .filter(
        F.col(
            "is_resolved"
        ) == True
    )

    .filter(
        F.col(
            "target_title"
        ).isNotNull()
    )

    .filter(
        F.trim(
            F.col(
                "target_title"
            )
        ) != ""
    )

    .select(
        "source_node",
        "source_title",
        "target_reference",
        "target_title",
        "link_type"
    )

    # ------------------------------------------------------
    # Same source + target = one LLM call
    # ------------------------------------------------------

    .dropDuplicates(
        [
            "source_node",
            "target_title"
        ]
    )
)


n_targets = (
    distinct_targets.count()
)


print(
    f"Unique document-target pairs : "
    f"{n_targets}"
)


# ==========================================================
# 26. GROUP TARGETS BY DOCUMENT
# ==========================================================
#
# IMPORTANT:
#
# Grouping DOES NOT mean one LLM call.
#
# It only creates:
#
# Document
#    |
#    +-- Target 1
#    +-- Target 2
#    +-- Target 3
#
# The worker later performs one LLM call for each target.
#
# ==========================================================

doc_entities = (

    distinct_targets

    .groupBy(
        "source_node",
        "source_title"
    )

    .agg(
        F.collect_list(
            F.struct(
                "target_title",
                "target_reference",
                "link_type"
            )
        ).alias(
            "entities"
        )
    )
)


# ==========================================================
# 27. JOIN FULL DOCUMENT CONTENT
# ==========================================================

doc_prompt_inputs = (

    doc_entities

    .join(
        document_rendered_df.select(
            "source_node",
            "content_with_titles"
        ),

        on="source_node",

        how="inner"
    )
)


# ==========================================================
# 28. CHECKPOINT
# ==========================================================

print()
print("=" * 80)
print("CHECKPOINT CHECK")
print("=" * 80)


table_exists = (
    spark.catalog.tableExists(
        CHECKPOINT_TABLE
    )
)


if table_exists:

    existing_checkpoint = (
        spark.table(
            CHECKPOINT_TABLE
        )
    )


    existing_columns = (
        existing_checkpoint.columns
    )


    # ------------------------------------------------------
    # Identify failed documents.
    # ------------------------------------------------------

    failed_conditions = [

        (
            "relationship_description "
            "LIKE '[extraction failed%'"
        )

    ]


    if "status" in existing_columns:

        failed_conditions.append(
            "status = 'failed'"
        )


    failed_sql = (
        " OR ".join(
            failed_conditions
        )
    )


    n_failed_docs = (

        spark.sql(
            f"""
            SELECT COUNT(DISTINCT source_node) AS n
            FROM {CHECKPOINT_TABLE}
            WHERE {failed_sql}
            """
        )
        .first()["n"]
    )


    # ------------------------------------------------------
    # Remove failed documents so they can be reprocessed.
    # ------------------------------------------------------

    if (
        n_failed_docs
        and
        RETRY_FAILED
    ):

        spark.sql(
            f"""
            DELETE FROM {CHECKPOINT_TABLE}
            WHERE source_node IN (
                SELECT source_node
                FROM {CHECKPOINT_TABLE}
                WHERE {failed_sql}
            )
            """
        )


        print(
            f"Failed documents queued for retry : "
            f"{n_failed_docs}"
        )


    # ------------------------------------------------------
    # Get completed documents.
    # ------------------------------------------------------

    already_done = (

        spark

        .table(
            CHECKPOINT_TABLE
        )

        .select(
            "source_node"
        )

        .distinct()
    )


    n_already_done = (
        already_done.count()
    )


    # ------------------------------------------------------
    # Skip completed documents.
    # ------------------------------------------------------

    doc_prompt_inputs = (

        doc_prompt_inputs

        .join(
            already_done,

            on="source_node",

            how="left_anti"
        )
    )


    print(
        f"Already checkpointed (skipped) : "
        f"{n_already_done} documents"
    )


else:

    print(
        "No existing checkpoint table found."
    )

    print(
        "Starting fresh."
    )

    print(
        f"New checkpoint : "
        f"{CHECKPOINT_TABLE}"
    )


# ==========================================================
# 29. COUNT DOCUMENTS TO PROCESS
# ==========================================================

n_docs_to_process = (
    doc_prompt_inputs.count()
)


print()
print(
    f"Documents to process this run : "
    f"{n_docs_to_process}"
)


# ==========================================================
# 30. RUN DISTRIBUTED EXTRACTION
# ==========================================================

if n_docs_to_process == 0:

    print()

    print(
        "Nothing to do -- all documents already "
        "checkpointed."
    )


else:

    print()
    print("=" * 80)
    print("STARTING ITERATIVE LLM EXTRACTION")
    print("=" * 80)

    print()

    print(
        "Flow:"
    )

    print(
        "Document"
        " -> "
        "Target"
        " -> "
        "Sentence"
        " -> "
        "6-word context"
        " -> "
        "LLM"
        " -> "
        "Predicate"
    )


    # ------------------------------------------------------
    # Rows before this run.
    # ------------------------------------------------------

    rows_before = (

        spark.table(
            CHECKPOINT_TABLE
        ).count()

        if table_exists

        else 0
    )


    # ------------------------------------------------------
    # Number of chunks.
    # ------------------------------------------------------

    n_chunks = max(
        1,
        -(
            -n_docs_to_process
            //
            CHUNK_DOCS
        )
    )


    # ------------------------------------------------------
    # Stateless chunk assignment.
    # ------------------------------------------------------

    chunked_inputs = (

        doc_prompt_inputs

        .withColumn(
            "_chunk_id",

            F.pmod(
                F.hash(
                    "source_node"
                ),

                F.lit(
                    n_chunks
                )
            )
        )
    )


    # ======================================================
    # PROCESS CHUNKS
    # ======================================================

    for chunk_id in range(
        n_chunks
    ):

        print()
        print(
            f"Processing chunk "
            f"{chunk_id + 1}/{n_chunks}"
        )


        chunk_df = (

            chunked_inputs

            .filter(
                F.col(
                    "_chunk_id"
                )
                ==
                chunk_id
            )

            .drop(
                "_chunk_id"
            )
        )


        # --------------------------------------------------
        # ONE TARGET -> ONE LLM CALL
        # --------------------------------------------------

        (

            chunk_df

            .repartition(
                N_PARTITIONS
            )

            .mapInPandas(
                process_partition_pandas,

                schema=
                    TRIPLES_SCHEMA
            )

            .write

            .mode(
                "append"
            )

            .option(
                "mergeSchema",
                "true"
            )

            .saveAsTable(
                CHECKPOINT_TABLE
            )
        )


        print(
            f"Chunk "
            f"{chunk_id + 1}/{n_chunks}"
            f" saved."
        )


    # ------------------------------------------------------
    # IMPORTANT:
    #
    # Count from SAVED checkpoint table.
    #
    # DO NOT call:
    #
    #     new_triples_df.count()
    #
    # because that could execute the LLM again.
    # ------------------------------------------------------

    rows_after = (

        spark

        .table(
            CHECKPOINT_TABLE
        )

        .count()
    )


    print()

    print(
        f"Relationships extracted this run : "
        f"{rows_after - rows_before}"
    )


    print(
        f"Checkpointed to : "
        f"{CHECKPOINT_TABLE}"
    )


