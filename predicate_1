    print("STARTING ITERATIVE LLM EXTRACTION")
    print("=" * 80)

    print()
    print(
        "Processing model:"
    )

    print(
        "Document → Target → Sentence → "
        "Local Context → LLM → Predicate"
    )

    # ------------------------------------------------------
    # Distributed execution
    # ------------------------------------------------------

    new_triples_df = (

        doc_prompt_inputs

        .repartition(
            N_PARTITIONS
        )

        .mapInPandas(
            process_partition_pandas,
            schema=TRIPLES_SCHEMA
        )
    )

    # ======================================================
    # IMPORTANT:
    #
    # DO NOT:
    #
    #     write()
    #     count()
    #
    # directly on a lazy LLM DataFrame.
    #
    # That could execute the LLM transformation twice.
    #
    # Instead:
    #
    #     1. count() -> execute once
    #     2. write cached result
    #
    # ======================================================

    new_triples_df = (
        new_triples_df
        .cache()
    )

    # ------------------------------------------------------
    # FIRST ACTION
    #
    # This executes the LLM calls once and caches the result.
    # ------------------------------------------------------

    n_new = (
        new_triples_df.count()
    )

    print()
    print(
        f"Relationships extracted this run : "
        f"{n_new}"
    )

    # ------------------------------------------------------
    # SECOND ACTION
    #
    # Cached result is written.
    # LLM should NOT run again.
    # ------------------------------------------------------

    (
        new_triples_df

        .write

        .mode("append")

        .option(
            "mergeSchema",
            "true"
        )

        .saveAsTable(
            CHECKPOINT_TABLE
        )
    )

    print()
    print(
        "Checkpoint successfully written."
    )

    print(
        f"Checkpoint table : "
        f"{CHECKPOINT_TABLE}"
    )


