# 17. DISTRIBUTED WORKER
#
# mapInPandas is used instead of RDD/mapPartitions because
# this notebook runs on Databricks serverless.
# ==========================================================

def process_partition_pandas(
    pdf_iterator
):

    import pandas as pd

    from langchain_openai import ChatOpenAI


    # ------------------------------------------------------
    # Create LLM client inside the executor.
    # ------------------------------------------------------

    partition_llm = ChatOpenAI(

        model=
            _CONN[
                "model"
            ],

        base_url=
            _CONN[
                "base_url"
            ],

        api_key=
            _CONN[
                "api_key"
            ],

        temperature=
            0,

        max_retries=
            0,

        timeout=
            LLM_TIMEOUT_SECONDS,

        max_tokens=
            LLM_MAX_TOKENS,
    )


    # ------------------------------------------------------
    # KEEP THESE COLUMNS COMPATIBLE WITH CELL 11.
    #
    # Additional diagnostic columns are allowed because
    # Cell 11 selects only the columns it needs.
    # ------------------------------------------------------

    out_columns = [

        "source_node",

        "source_title",

        "predicate",

        "relationship_description",

        "relationship_strength",

        "target_title",

        "target_reference",

        "link_type",

        "status",

        "evidence_sentence",

        "mention_count",
    ]


    # ======================================================
    # PROCESS EACH ARROW BATCH
    # ======================================================

    for pdf in pdf_iterator:

        out_rows = []


        # --------------------------------------------------
        # Each row represents one document and its targets.
        # --------------------------------------------------

        for _, row in pdf.iterrows():

            source_node = (
                row[
                    "source_node"
                ]
            )

            source_title = (
                row[
                    "source_title"
                ]
            )

            content = (
                row[
                    "content_with_titles"
                ]
            )

            entities = (
                row[
                    "entities"
                ]
            )


            # Prepare the whole document ONCE.
            #
            # The whole document is used only by CODE to find
            # the sentence. The whole document is NOT sent
            # to the LLM.

            prepared_document = (
                _prepare_document(
                    content
                )
            )


            # --------------------------------------------------
            # ONE TARGET AT A TIME
            # --------------------------------------------------

            for entity in entities:

                target_title = (
                    entity[
                        "target_title"
                    ]
                )

                target_reference = (
                    entity[
                        "target_reference"
                    ]
                )

                link_type = (
                    entity[
                        "link_type"
                    ]
                )

                mention_count = int(
                    entity[
                        "mention_count"
                    ]
                )


                # ----------------------------------------------
                # ONE TARGET -> ONE LLM CALL
                # ----------------------------------------------

                result = _extract_one_target(

                    partition_llm,

                    source_title,

                    prepared_document,

                    target_title,
                )


                # ----------------------------------------------
                # ONE OUTPUT RELATIONSHIP
                # ----------------------------------------------

                out_rows.append({

                    # SOURCE = DOCUMENT TITLE
                    "source_node":
                        source_title,

                    "source_title":
                        source_title,

                    "predicate":
                        result[
                            "predicate"
                        ],

                    "relationship_description":
                        result[
                            "description"
                        ],

                    "relationship_strength":
                        result[
                            "strength"
                        ],

                    # TARGET = RESOLVED TARGET TITLE
                    "target_title":
                        target_title,

                    "target_reference":
                        target_reference,

                    "link_type":
                        link_type,

                    "status":
                        result[
                            "status"
                        ],

                    "evidence_sentence":
                        result[
                            "evidence_sentence"
                        ],

                    "mention_count":
                        mention_count,
                })


        # --------------------------------------------------
        # ALWAYS yield correct schema.
        # --------------------------------------------------

        yield pd.DataFrame(
            out_rows,
            columns=
                out_columns
        )


