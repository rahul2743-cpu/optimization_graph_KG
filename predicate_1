# ==========================================================
# 5. UNRESOLVED DOCUMENT MARKUP
# ==========================================================

# Raw unresolved references such as:
#
# <doc:wiki:Temp_Import....>
#
# are NOT targets.
#
# They are removed before sentence/context extraction.

_UNRESOLVED_MARKUP_RE = re.compile(
    r"\[?<doc:(?:wiki:)?[^<>]+>\]?"
)


# ==========================================================
# 6. SANITIZE TEXT
# ==========================================================

def _sanitize_for_llm(text):
    """
    Remove unresolved document markup and normalize
    whitespace.

    Resolved hyperlinks such as:

        <MTCCM>

    remain unchanged.
    """

    text = text or ""

    text = _UNRESOLVED_MARKUP_RE.sub(
        " ",
        text
    )

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


# ==========================================================
# 7. NORMALIZE PREDICATE
# ==========================================================

def _to_snake_case(s):
    """
    Convert the LLM predicate into lowercase snake_case.
    """

    s = (s or "").strip().lower()

    s = re.sub(
        r"[^a-z0-9]+",
        "_",
        s
    )

    s = re.sub(
        r"_+",
        "_",
        s
    )

    s = s.strip("_")

    return s or "related_to"


# ==========================================================
# 8. FIND SENTENCE CONTAINING TARGET
# ==========================================================

def _find_sentence_for_entity(
    text,
    entity_name
):
    """
    Find the sentence containing:

        <Entity Name>

    Example:

        Any changes made will be lost if <MTCCM> is uninstalled.
    """

    text = _sanitize_for_llm(text)

    if not text:
        return ""

    # ------------------------------------------------------
    # Find exact target hyperlink
    # ------------------------------------------------------

    target_pattern = re.compile(
        rf"<\s*{re.escape(entity_name)}\s*>",
        flags=re.IGNORECASE
    )

    target_match = target_pattern.search(text)

    if not target_match:
        return ""

    target_start = target_match.start()
    target_end = target_match.end()

    # ------------------------------------------------------
    # Find all hyperlink spans.
    #
    # This prevents punctuation inside:
    #
    # <MTCCM.Run>
    #
    # from being interpreted as a sentence boundary.
    # ------------------------------------------------------

    link_spans = [
        match.span()
        for match in re.finditer(
            r"<[^<>]+>",
            text
        )
    ]

    def is_inside_link(position):

        for start, end in link_spans:

            if start <= position < end:
                return True

        return False


    # ------------------------------------------------------
    # Find sentence beginning
    # ------------------------------------------------------

    sentence_start = 0

    i = target_start - 1

    while i >= 0:

        if (
            text[i] in ".!?"
            and not is_inside_link(i)
        ):

            sentence_start = i + 1

            break

        i -= 1


    # ------------------------------------------------------
    # Find sentence ending
    # ------------------------------------------------------

    sentence_end = len(text)

    i = target_end

    while i < len(text):

        if (
            text[i] in ".!?"
            and not is_inside_link(i)
        ):

            sentence_end = i + 1

            break

        i += 1


    sentence = text[
        sentence_start:sentence_end
    ].strip()

    return sentence


# ==========================================================
# 9. EXTRACT LOCAL 6-WORD CONTEXT
# ==========================================================

def _extract_local_context(
    sentence,
    entity_name,
    window=6
):
    """
    Extract:

        6 words before target
        +
        <target>
        +
        6 words after target
    """

    if not sentence:
        return ""

    pattern = re.compile(
        rf"<\s*{re.escape(entity_name)}\s*>",
        flags=re.IGNORECASE
    )

    match = pattern.search(sentence)

    if not match:
        return ""

    # ------------------------------------------------------
    # Text before target
    # ------------------------------------------------------

    before = sentence[
        :match.start()
    ].strip()


    # ------------------------------------------------------
    # Text after target
    # ------------------------------------------------------

    after = sentence[
        match.end():
    ].strip()


    # ------------------------------------------------------
    # Extract words
    # ------------------------------------------------------

    before_words = re.findall(
        r"\S+",
        before
    )

    after_words = re.findall(
        r"\S+",
        after
    )


    # ------------------------------------------------------
    # Keep only 6 words
    # ------------------------------------------------------

    before_words = before_words[
        -window:
    ]

    after_words = after_words[
        :window
    ]


    # ------------------------------------------------------
    # Keep the actual hyperlink
    # ------------------------------------------------------

    hyperlink = match.group(0)


    # ------------------------------------------------------
    # Build local context
    # ------------------------------------------------------

    local_context = (
        " ".join(before_words)
        + " "
        + hyperlink
        + " "
        + " ".join(after_words)
    )

    return re.sub(
        r"\s+",
        " ",
        local_context
    ).strip()


# ==========================================================
# 10. BUILD CONTEXT FOR ONE TARGET
# ==========================================================

def _build_entity_context(
    content,
    entity_name
):
    """
    For ONE target:

        document
            ↓
        find target sentence
            ↓
        extract 6-word local context
    """

    sentence = _find_sentence_for_entity(
        content,
        entity_name
    )

    if not sentence:
        return "", ""


    local_context = _extract_local_context(
        sentence,
        entity_name,
        LOCAL_CONTEXT_WORDS
    )


    # ------------------------------------------------------
    # Protect the LLM from extremely large sentences.
    # ------------------------------------------------------

    if len(sentence) > MAX_SENTENCE_CHARS:

        sentence = (
            sentence[:MAX_SENTENCE_CHARS]
            + " ...[sentence truncated]"
        )


    return (
        sentence,
        local_context
    )


# ==========================================================
# 11. PARSE ONE LLM RESPONSE
# ==========================================================

def _parse_single_record(
    text,
    entity_name
):
    """
    Parse ONE LLM response.

    Expected:

        Entity
        <|>
        predicate
        <|>
        description
        <|>
        strength
        ##
    """

    if not text:

        return (
            "related_to",
            "",
            5
        )


    # ------------------------------------------------------
    # Only use the first record.
    # ------------------------------------------------------

    record = (
        text
        .split(RECORD_DELIM)[0]
        .strip()
        .strip(",")
    )


    # ------------------------------------------------------
    # Split fields.
    # ------------------------------------------------------

    parts = [
        p.strip()
        for p in record.split(
            TUPLE_DELIM
        )
    ]


    # ------------------------------------------------------
    # Validate.
    # ------------------------------------------------------

    if len(parts) < 3:

        return (
            "related_to",
            "",
            5
        )


    # ------------------------------------------------------
    # Predicate.
    # ------------------------------------------------------

    predicate = _to_snake_case(
        parts[1]
    )


    # ------------------------------------------------------
    # Description.
    # ------------------------------------------------------

    description = parts[2]


    # ------------------------------------------------------
    # Strength.
    # ------------------------------------------------------

    try:

        strength_text = (
            parts[3]
            if len(parts) > 3
            else "5"
        )

        numbers = re.sub(
            r"\D",
            "",
            strength_text
        )

        strength = int(
            numbers
        )

        strength = max(
            1,
            min(
                10,
                strength
            )
        )

    except (
        ValueError,
        TypeError
    ):

        strength = 5


    return (
        predicate,
        description,
        strength
    )


# ==========================================================
# 12. DISTRIBUTED WORKER
# ==========================================================

def process_partition_pandas(
    pdf_iterator
):

    import pandas as pd

    from langchain_openai import ChatOpenAI


    # ------------------------------------------------------
    # Create one LLM client per Spark partition.
    # ------------------------------------------------------

    partition_llm = ChatOpenAI(
        model=_CONN["model"],
        base_url=_CONN["base_url"],
        api_key=_CONN["api_key"],
        temperature=0,
        max_retries=0,
        timeout=LLM_TIMEOUT_SECONDS,
        max_tokens=LLM_MAX_TOKENS,
    )


    # ------------------------------------------------------
    # KEEP SAME OUTPUT SCHEMA AS EXISTING CELL 10
    #
    # This means downstream cells do not need modification.
    # ------------------------------------------------------

    out_columns = [
        "source_node",
        "source_title",
        "predicate",
        "relationship_description",
        "relationship_strength",
        "target_title",
        "target_reference",
        "link_type",
    ]


    # ======================================================
    # PROCESS ARROW BATCH
    # ======================================================

    for pdf in pdf_iterator:

        out_rows = []


        # ==================================================
        # LOOP 1:
        # DOCUMENT BY DOCUMENT
        # ==================================================

        for _, row in pdf.iterrows():

            source_title = row[
                "source_title"
            ]

            content = row[
                "content_with_titles"
            ]

            entities = row[
                "entities"
            ]


            # ==================================================
            # LOOP 2:
            # ONE TARGET AT A TIME
            #
            # THIS IS THE IMPORTANT PART.
            # ==================================================

            for entity in entities:

                target_title = (
                    entity["target_title"]
                )

                target_reference = (
                    entity["target_reference"]
                )

                link_type = (
                    entity["link_type"]
                )


                try:

                    # ==========================================
                    # STEP 1:
                    # SOURCE = DOCUMENT TITLE
                    # ==========================================

                    source_node = source_title


                    # ==========================================
                    # STEP 2:
                    # FIND TARGET SENTENCE
                    # ==========================================

                    sentence, local_context = (
                        _build_entity_context(
                            content,
                            target_title
                        )
                    )


                    # ==========================================
                    # STEP 3:
                    # IF TARGET SENTENCE NOT FOUND
                    # ==========================================

                    if not sentence:

                        predicate = "related_to"

                        description = (
                            "[No sentence containing "
                            "target hyperlink was found]"
                        )

                        strength = 1


                    else:

                        # ======================================
                        # STEP 4:
                        # BUILD PROMPT FOR ONE TARGET ONLY
                        # ======================================

                        user_prompt = f"""
SOURCE DOCUMENT TITLE:
{source_title}


TARGET ENTITY:
{target_title}


FULL SENTENCE CONTAINING THE TARGET:
{sentence}


FOCUSED LOCAL CONTEXT:
{local_context}


TASK:

Determine the ONE semantic relationship between:

SOURCE:
{source_title}

TARGET:
{target_title}

The SOURCE is the subject.

The TARGET is the object.

Use the full sentence as the primary context.

Use the local context as additional focused context.

Return exactly ONE predicate.
"""


                        # ======================================
                        # STEP 5:
                        # ONE LLM CALL
                        #
                        # If the API fails, retry the SAME
                        # target. We never combine targets.
                        # ======================================

                        response = None
                        last_error = None

                        for attempt in range(
                            1,
                            LLM_MAX_RETRIES + 1
                        ):

                            try:

                                response = (
                                    partition_llm.invoke(
                                        [
                                            {
                                                "role": "system",
                                                "content":
                                                    SYSTEM_PROMPT,
                                            },
                                            {
                                                "role": "user",
                                                "content":
                                                    user_prompt,
                                            },
                                        ]
                                    )
                                )

                                break

                            except Exception as e:

                                last_error = e

                                if (
                                    attempt
                                    < LLM_MAX_RETRIES
                                ):

                                    time.sleep(
                                        RETRY_SLEEP_SECONDS
                                        * attempt
                                    )


                        # --------------------------------------
                        # All retries failed.
                        # --------------------------------------

                        if response is None:

                            raise RuntimeError(
                                f"LLM failed after "
                                f"{LLM_MAX_RETRIES} attempts: "
                                f"{last_error}"
                            )


                        # ======================================
                        # STEP 6:
                        # PARSE ONE PREDICATE
                        # ======================================

                        (
                            predicate,
                            description,
                            strength
                        ) = _parse_single_record(
                            response.content.strip(),
                            target_title
                        )


                except Exception as e:

                    # ==========================================
                    # ONE TARGET FAILURE DOES NOT KILL THE
                    # ENTIRE DOCUMENT.
                    # ==========================================

                    predicate = "related_to"

                    description = (
                        f"[extraction failed: "
                        f"{type(e).__name__}: "
                        f"{str(e)[:300]}]"
                    )

                    strength = 1


                # ==================================================
                # STEP 7:
                # CREATE ONE RDF RELATIONSHIP ROW
                # ==================================================

                out_rows.append(
                    {

                        # SOURCE = DOCUMENT TITLE
                        "source_node":
                            source_title,

                        "source_title":
                            source_title,

                        "predicate":
                            predicate,

                        "relationship_description":
                            description,

                        "relationship_strength":
                            strength,

                        # TARGET = RESOLVED TARGET
                        "target_title":
                            target_title,

                        "target_reference":
                            target_reference,

                        "link_type":
                            link_type,
                    }
                )


        # ==================================================
        # RETURN CURRENT BATCH
        # ==================================================

        yield pd.DataFrame(
            out_rows,
            columns=out_columns
        )


