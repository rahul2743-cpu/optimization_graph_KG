# ==========================================================
# 12. CHECKPOINTING
# ==========================================================
#
# IMPORTANT:
#
# We checkpoint by link_uid, NOT source_node.
#
# This is important because one document can contain
# many hyperlinks.
#
# ==========================================================

try:

    already_done = (

        spark.table(
            CHECKPOINT_TABLE
        )

        .select(
            "link_uid"
        )

        .distinct()
    )


    n_already_done = (
        already_done.count()
    )


    predicate_inputs = (

        predicate_inputs

        .join(
            already_done,
            on="link_uid",
            how="left_anti"
        )

    )


    print(
        f"Already checkpointed links : "
        f"{n_already_done}"
    )


except Exception:

    print(
        "No existing local-context checkpoint "
        f"table found."
    )

    print(
        f"Starting fresh at: "
        f"{CHECKPOINT_TABLE}"
    )


# ==========================================================
# 13. COUNT WORK
# ==========================================================

n_links_to_process = (
    predicate_inputs.count()
)

print(
    f"Hyperlink occurrences to process : "
    f"{n_links_to_process}"
)


# ==========================================================
# 14. DISTRIBUTED LLM EXTRACTION
# ==========================================================

if n_links_to_process == 0:

    print()
    print(
        "Nothing to do -- all hyperlink "
        "occurrences are already checkpointed."
    )

else:

    print()
    print(
        "Starting distributed local-context "
        "predicate extraction..."
    )


    new_triples_df = (

        predicate_inputs

        .repartition(
            N_PARTITIONS
        )

        .mapInPandas(
            process_partition_pandas,
            schema=TRIPLES_SCHEMA
        )

    )


    # ======================================================
    # 15. CHECKPOINT RESULTS
    # ======================================================

    (
        new_triples_df.write

        .mode("append")

        .option(
            "mergeSchema",
            "true"
        )

        .saveAsTable(
            CHECKPOINT_TABLE
        )
    )


    n_new = (
        new_triples_df.count()
    )


    print()
    print(
        f"Relationships extracted : "
        f"{n_new}"
    )

    print(
        f"Checkpoint table : "
        f"{CHECKPOINT_TABLE}"
    )


# ==========================================================
# 16. LOAD ALL RELATIONSHIPS
# ==========================================================

triples_df = (

    spark.table(
        CHECKPOINT_TABLE
    )

    .cache()

)


n_total = (
