    # ------------------------------------------------------

    (
        new_triples_df

        .write

        .mode("append")

        .option(
            "mergeSchema",
            "true"
        )

        .saveAsTable(
            CHECKPOINT_TABLE
        )
    )


    # ------------------------------------------------------
    # Count ONLY from the SAVED CHECKPOINT TABLE.
    #
    # Do NOT call new_triples_df.count() here because
    # new_triples_df is lazy and could execute the LLM
    # extraction again.
    # ------------------------------------------------------

    rows_after = (

        spark.table(
            CHECKPOINT_TABLE
        ).count()
    )


    n_new = (
        rows_after - rows_before
    )


    print()
    print(
        f"Relationships extracted this run : "
        f"{n_new}"
