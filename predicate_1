# 2. CONFIG
# ----------------------------------------------------------

N_PARTITIONS = 16
CHUNK_TARGETS = 500

CHECKPOINT_TABLE = (
    "knwbt_airr_foundry_dev_catalog.secured."
    "kg_relationship_checkpoint_cell10_v2"
)

LLM_MAX_RETRIES = 6
LLM_TIMEOUT_SECONDS = 60
LLM_MAX_TOKENS = 200
RETRY_SLEEP_SECONDS = 2

LOCAL_CONTEXT_WORDS = 6
MAX_SENTENCE_CHARS = 4000
MAX_EVIDENCE_CHARS = 1500

RETRY_FAILED = True

