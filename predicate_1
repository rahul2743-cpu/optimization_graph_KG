        )
    )
)


# ----------------------------------------------------------
# First occurrence per document-target.
#
# occurrence comes from Cell 8b.
# ----------------------------------------------------------

first_occurrence_window = (
    Window
    .partitionBy(
        *KEY_COLS
    )
    .orderBy(
        F.col(
            "occurrence"
        ).asc()
    )
)


targets_all = (

    resolved_occurrences

    .withColumn(
        "_row_number",

        F.row_number().over(
            first_occurrence_window
        )
    )

    .filter(
        F.col(
            "_row_number"
        )
        ==
        1
    )

    .drop(
        "_row_number"
    )

    .join(
        mention_counts,

        on=KEY_COLS,

        how="left"
    )

    .select(
        "source_node",
        "source_title",
        "target_reference",
        "target_title",
        "link_type",
        "sentence_masked",
        "mention_count",
    )
)


n_occurrences = (
    resolved_occurrences.count()
)

n_pairs = (
    mention_counts.count()
)

n_targets = (
    targets_all.count()
)


print(
    f"Resolved link occurrences       : "
    f"{n_occurrences}"
)

print(
    f"Distinct document-target pairs : "
    f"{n_pairs}"
)

print(
    f"LLM work items                 : "
    f"{n_targets}"
)


# ==========================================================
# 20. PREPARE DOCUMENT + TARGET LIST
#
# We use the FIRST occurrence information above only to
# establish the target work item.
#
# The actual sentence is located again from the full
# document content in process_partition_pandas.
# ==========================================================

doc_entities = (

    targets_all

    .groupBy(
        "source_node",
        "source_title"
    )

    .agg(
        F.collect_list(
            F.struct(
                "target_title",
                "target_reference",
                "link_type",
                "mention_count",
            )
        ).alias(
            "entities"
        )
    )
)


# ==========================================================
# 21. JOIN FULL DOCUMENT CONTENT
# ==========================================================

doc_prompt_inputs = (

    doc_entities

    .join(

        document_rendered_df.select(

            "source_node",

            "content_with_titles",
        ),

        on="source_node",

        how="inner",
    )
)


# ==========================================================
# 22. CHECKPOINT / RESUME
#
# Checkpoint key:
#
#   source_node + target_title
#
# This means:
#
#   finished target -> skip
#   failed target   -> retry
#   unfinished      -> process
#
# ==========================================================

print()
print("=" * 80)
print("CHECKPOINT CHECK")
print("=" * 80)


table_exists = (
    spark.catalog.tableExists(
        CHECKPOINT_TABLE
    )
)


if table_exists:

    checkpoint_df = (
        spark.table(
            CHECKPOINT_TABLE
        )
    )


    checkpoint_columns = (
        checkpoint_df.columns
    )


    # ------------------------------------------------------
    # Identify failed targets.
    # ------------------------------------------------------

    failed_condition = (
        F.col(
            "status"
        )
        ==
        "failed"
    )


    if "status" in checkpoint_columns:

        failed_keys = (

            checkpoint_df

            .filter(
                failed_condition
            )

            .select(
                *KEY_COLS
            )

            .distinct()
        )


    else:

        failed_keys = (
            spark.createDataFrame(
                [],
                schema=(
                    targets_all
                    .select(
                        *KEY_COLS
                    )
                    .schema
                )
            )
        )


    n_failed = (
        failed_keys.count()
    )


    # ------------------------------------------------------
    # Delete failed targets so they can be retried.
    # ------------------------------------------------------

    if (
        n_failed
        and
        RETRY_FAILED
    ):

        failed_key_rows = (
            failed_keys
            .collect()
        )


        # Small list because this only contains failed
        # targets, not all 20k documents.

        for failed_row in failed_key_rows:

            source_node_value = (
                failed_row[
                    "source_node"
                ]
            )

            target_title_value = (
                failed_row[
                    "target_title"
                ]
            )


            spark.sql(
                f"""
                DELETE FROM {CHECKPOINT_TABLE}
                WHERE source_node = ?
                  AND target_title = ?
                """,
                args=[
                    source_node_value,
                    target_title_value,
                ],
            )


        print(
            f"Failed targets queued for retry : "
            f"{n_failed}"
        )


    # ------------------------------------------------------
    # Read successfully checkpointed targets.
    # ------------------------------------------------------

    if (
        RETRY_FAILED
        and
        "status" in checkpoint_columns
    ):

        already_done = (

            spark.table(
                CHECKPOINT_TABLE
            )

            .filter(
                F.col(
                    "status"
                )
                ==
                "ok"
            )

            .select(
                *KEY_COLS
            )

            .distinct()
        )

    else:

        already_done = (

            spark.table(
                CHECKPOINT_TABLE
            )

            .select(
                *KEY_COLS
            )

            .distinct()
        )


    n_already_done = (
        already_done.count()
    )


    # ------------------------------------------------------
    # Skip completed targets.
    # ------------------------------------------------------

    targets_to_process = (

        targets_all

        .join(
            already_done,

            on=KEY_COLS,

            how="left_anti"
        )
    )


    # Rebuild documents from remaining targets.
    # ------------------------------------------------------

    doc_entities = (

        targets_to_process

        .groupBy(
            "source_node",
            "source_title"
        )

        .agg(
            F.collect_list(
                F.struct(
                    "target_title",
                    "target_reference",
                    "link_type",
                    "mention_count",
                )
            ).alias(
                "entities"
            )
        )
    )


    doc_prompt_inputs = (

        doc_entities

        .join(

            document_rendered_df.select(
                "source_node",
                "content_with_titles",
            ),

            on="source_node",

            how="inner",
        )
    )


    print(
        f"Already checkpointed (skipped) : "
        f"{n_already_done} targets"
    )


else:

    targets_to_process = (
        targets_all
    )


    print(
        "No existing checkpoint table found."
    )

    print(
        "Starting fresh."
    )

    print(
        f"New checkpoint : "
        f"{CHECKPOINT_TABLE}"
    )


# ==========================================================
# 23. COUNT WORK
# ==========================================================

n_to_process = (
    targets_to_process.count()
)


print()
print(
    f"Targets to process this run : "
    f"{n_to_process}"
)


# ==========================================================
# 24. RUN LLM EXTRACTION IN CHUNKS
# ==========================================================

if n_to_process == 0:

    print()

    print(
        "Nothing to do -- all targets already "
        "checkpointed."
    )


else:

    # ------------------------------------------------------
    # Rows before this run.
    # ------------------------------------------------------

    rows_before = (

        spark.table(
            CHECKPOINT_TABLE
        ).count()

        if table_exists

        else 0
    )


    # ------------------------------------------------------
    # Number of chunks.
    # ------------------------------------------------------

    n_chunks = max(
        1,
        -(
            -n_to_process
            //
            CHUNK_TARGETS
        )
    )


    # ------------------------------------------------------
    # Stateless chunking.
    #
    # No giant target list is collected to the driver.
    # ------------------------------------------------------

    chunked = (

        targets_to_process

        .withColumn(
            "_chunk_id",

            F.pmod(
                F.hash(
                    *KEY_COLS
                ),

                F.lit(
                    n_chunks
                )
            )
        )
    )


    print()
    print(
        f"Total chunks : "
        f"{n_chunks}"
    )


    # ======================================================
    # CHUNK LOOP
    # ======================================================

    for chunk_id in range(
        n_chunks
    ):

        print()
        print(
            f"Processing chunk "
            f"{chunk_id + 1}/{n_chunks}"
        )


        chunk_targets = (

            chunked

            .filter(
                F.col(
                    "_chunk_id"
                )
                ==
                chunk_id
            )

            .drop(
                "_chunk_id"
            )
        )


        # --------------------------------------------------
        # Rebuild document -> target structure for this
        # chunk.
        # --------------------------------------------------

        chunk_doc_entities = (

            chunk_targets

            .groupBy(
                "source_node",
                "source_title"
            )

            .agg(
                F.collect_list(
                    F.struct(
                        "target_title",
                        "target_reference",
                        "link_type",
                        "mention_count",
                    )
                ).alias(
                    "entities"
                )
            )
        )


        # --------------------------------------------------
        # Join full document content.
        # --------------------------------------------------

        chunk_input = (

            chunk_doc_entities

            .join(

                document_rendered_df.select(
                    "source_node",
                    "content_with_titles",
                ),

                on="source_node",

                how="inner",
            )
        )


        # --------------------------------------------------
        # DISTRIBUTED LLM EXTRACTION
        #
        # mapInPandas -> Spark executors
        #
        # Within each document:
        #
        #     target 1 -> LLM call
        #     target 2 -> LLM call
        #     target 3 -> LLM call
        #
        # Each call contains ONE target only.
        # --------------------------------------------------

        (

            chunk_input

            .repartition(
                N_PARTITIONS
            )

            .mapInPandas(

                process_partition_pandas,

                schema=
                    TRIPLES_SCHEMA,
            )

            .write

            .mode(
                "append"
            )

            .option(
                "mergeSchema",
                "true"
            )

            .saveAsTable(
                CHECKPOINT_TABLE
            )
        )


        print(
            f"  chunk {chunk_id + 1}/{n_chunks} saved"
        )


    # ------------------------------------------------------
    # IMPORTANT:
    #
    # Count from the SAVED checkpoint table.
    #
    # Do NOT call:
    #
    #     new_triples_df.count()
    #
    # because that could execute the LLM calls again.
    # ------------------------------------------------------

    rows_after = (

        spark

        .table(
            CHECKPOINT_TABLE
        )

        .count()
    )


    print()
    print(
        f"Relationships extracted this run : "
        f"{rows_after - rows_before}"
    )


    print(
        f"Checkpointed to : "
        f"{CHECKPOINT_TABLE}"
    )


# ==========================================================
# 25. LOAD FINAL CHECKPOINT
# ==========================================================

if not spark.catalog.tableExists(
    CHECKPOINT_TABLE
):

    raise RuntimeError(
        f"{CHECKPOINT_TABLE} does not exist."
    )


triples_all_df = (

    spark

    .table(
        CHECKPOINT_TABLE
    )
)


# ==========================================================
# 26. USABLE TRIPLES
