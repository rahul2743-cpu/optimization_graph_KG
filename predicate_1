# ==========================================================
# Cell 10 : LOCAL-CONTEXT LLM RELATIONSHIP EXTRACTION
#
# PURPOSE
# -------
# For EACH hyperlink occurrence:
#
#   Source Document
#        |
#        | predicate
#        v
#   Target Entity
#
# The LLM DOES NOT receive the entire XML document.
#
# It receives only:
#   1. Source document title
#   2. Target entity
#   3. The sentence containing the hyperlink
#      OR approximately 6 words before + 6 words after
#
# This makes predicate extraction depend on the LOCAL meaning
# around the hyperlink instead of unrelated content elsewhere
# in the 20k-document XML.
#
# Needs:
#   - sentences_df       (Cell 8b)
#
# Does NOT need:
#   - document_rendered_df
#
# ==========================================================

import re

from pyspark.sql import functions as F
from pyspark.sql.types import (
    StructType,
    StructField,
    StringType,
    IntegerType
)

print("=" * 80)
print("CELL 10 — LOCAL-CONTEXT LLM RELATIONSHIP EXTRACTION")
print("=" * 80)


# ==========================================================
# 1. CONFIGURATION
# ==========================================================

N_PARTITIONS = 40

# Maximum number of words sent around the hyperlink
CONTEXT_WORDS = 6

# If sentence is short, use complete sentence.
# If sentence is longer, use local 6-before / 6-after context.
MAX_FULL_SENTENCE_WORDS = 30

# IMPORTANT:
# Use a NEW checkpoint table because the previous Cell 10
# checkpoint contains document-level relationships.
CHECKPOINT_TABLE = (
    "knwbt_airr_foundry_dev_catalog.secured."
    "kg_relationship_checkpoint_local_context"
)


# ==========================================================
# 2. LLM CONNECTION CONFIGURATION
# ==========================================================

_CONN = {
    "model": DEPLOYMENT_NAME,
    "base_url": (
        "https://adb-3955688708870984.4.azuredatabricks.net/"
        "serving-endpoints"
    ),
    "api_key": DATABRICKS_TOKEN,
}


# ==========================================================
# 3. OUTPUT DELIMITERS
# ==========================================================

TUPLE_DELIM = "<|>"
RECORD_DELIM = "##"


# ==========================================================
# 4. SYSTEM PROMPT
# ==========================================================

SYSTEM_PROMPT = f"""
---Role---

You are an AI assistant extracting relationships for a knowledge graph.


---Goal---

You are given:

1. A SOURCE document/entity.
2. ONE TARGET entity represented by a hyperlink.
3. ONLY the local textual context surrounding that hyperlink.

Your job is to determine WHY the source and target are connected
based ONLY on the provided local context.

DO NOT use knowledge outside the provided context.

DO NOT assume relationships that are not supported by the text.


---IMPORTANT CONTEXT RULE---

The provided context is intentionally small.

It contains either:

- the complete sentence containing the hyperlink, OR
- approximately 6 words before and 6 words after the hyperlink.

The target entity is represented using <Entity Name>.

Focus primarily on the words surrounding <Entity Name>.


---Predicate rules---

Return exactly ONE predicate.

The predicate must:

- be lowercase
- use snake_case
- contain 1-5 words
- contain no spaces
- contain no hyphens

Examples:

works_at
is_defined_by
is_part_of
depends_on
is_subject_to
uses
contains
related_to


---Very important---

Do NOT invent a specific relationship if the context does not
clearly support one.

If the relationship is unclear or only generally associated,
return:

related_to


---Description---

Give a short explanation of WHY the source and target are connected.

The explanation must be based ONLY on the provided context.

Do not use information from outside the context.


---Strength---

Return an integer from 1 to 10.

10 = very explicit relationship
8-9 = strong relationship
5-7 = reasonably clear relationship
3-4 = weak relationship
1-2 = very unclear/incidental


---Output format---

Return EXACTLY:

<entity name>{TUPLE_DELIM}<predicate>{TUPLE_DELIM}<description>{TUPLE_DELIM}<strength>{RECORD_DELIM}

No JSON.
No markdown.
No additional explanation.
"""


# ==========================================================
# 5. PREDICATE NORMALIZATION
# ==========================================================

def _to_snake_case(s):

    s = s.strip().lower()

    s = re.sub(
        r"[^a-z0-9]+",
        "_",
        s
    )

    s = re.sub(
        r"_+",
        "_",
        s
    )

    s = s.strip("_")

    return s or "related_to"


# ==========================================================
# 6. PARSE LLM RESPONSE
# ==========================================================

def _parse_record(text, entity_name):

    if not text:
        return (
            "related_to",
            "",
            5
        )

    # We expect:
    #
    # entity<|>predicate<|>description<|>strength##

    record = text.split(RECORD_DELIM)[0].strip()

    parts = [
        p.strip()
        for p in record.split(TUPLE_DELIM)
    ]

    if len(parts) < 2:
        return (
            "related_to",
            "",
            5
        )

    predicate = _to_snake_case(
        parts[1]
    )

    description = (
        parts[2]
        if len(parts) > 2
        else ""
    )

    try:

        strength_text = (
            parts[3]
            if len(parts) > 3
            else "5"
        )

        numbers = re.findall(
            r"\d+",
            strength_text
        )

        strength = (
            int(numbers[0])
            if numbers
            else 5
        )

        strength = max(
            1,
            min(10, strength)
        )

    except Exception:

        strength = 5

    return (
        predicate,
        description,
        strength
    )


# ==========================================================
# 7. LOCAL CONTEXT EXTRACTION
# ==========================================================
#
# Example sentence:
#
# The process is a sub-set of the total workflow needed to
# completely define the fluid system of a new or modified
# Rolls-Royce <Gas Turbine>.
#
# We do NOT send the entire document.
#
# We create:
#
# fluid system of a new or modified Rolls-Royce <Gas Turbine>
#
# or similar local context.
#
# ==========================================================

def _local_context(
    sentence,
    target_title,
    context_words=6,
    max_full_sentence_words=30
):

    if not sentence:
        return ""

    sentence = re.sub(
        r"\s+",
        " ",
        str(sentence)
    ).strip()

    if not sentence:
        return ""

    # ------------------------------------------------------
    # Find the target represented as:
    #
    # <Gas Turbine>
    #
    # ------------------------------------------------------

    target_pattern = re.compile(
        r"<\s*"
        + re.escape(target_title.strip())
        + r"\s*>",
        flags=re.IGNORECASE
    )

    match = target_pattern.search(sentence)

    # ------------------------------------------------------
    # If target cannot be located, safely use the sentence.
    # ------------------------------------------------------

    if not match:
        return sentence

    # ------------------------------------------------------
    # Tokenize while preserving the target as one token.
    #
    # Example:
    #
    # ["fluid", "system", "of", "a", "new", "or",
    #  "modified", "Rolls-Royce", "<Gas Turbine>"]
    # ------------------------------------------------------

    before = sentence[:match.start()].strip()
    after = sentence[match.end():].strip()

    before_words = before.split()
    after_words = after.split()

    # ------------------------------------------------------
    # If sentence is short, use the ENTIRE sentence.
    # ------------------------------------------------------

    total_words = (
        len(before_words)
        + 1
        + len(after_words)
    )

    if total_words <= max_full_sentence_words:

        return sentence

    # ------------------------------------------------------
    # Otherwise take:
    #
    # 6 words BEFORE
    # +
    # TARGET
    # +
    # 6 words AFTER
    # ------------------------------------------------------

    before_context = before_words[
        -context_words:
    ]

    after_context = after_words[
        :context_words
    ]

    local = (
        before_context
        + [f"<{target_title}>"]
        + after_context
    )

    return " ".join(local)


# ==========================================================
# 8. DISTRIBUTED LLM WORKER
# ==========================================================

def process_partition_pandas(pdf_iterator):

    import pandas as pd

    from langchain_openai import ChatOpenAI


    # ------------------------------------------------------
    # Create one LLM client per partition
    # ------------------------------------------------------

    partition_llm = ChatOpenAI(
        model=_CONN["model"],
        base_url=_CONN["base_url"],
        api_key=_CONN["api_key"],
        temperature=0,
    )


    # ------------------------------------------------------
    # Output columns
    # ------------------------------------------------------

    out_columns = [

        "link_uid",

        "source_node",

        "source_title",

        "predicate",

        "relationship_description",

        "relationship_strength",

        "target_title",

        "target_reference",

        "link_type",

        "context_used",

    ]


    # ------------------------------------------------------
    # Process Arrow batches
    # ------------------------------------------------------

    for pdf in pdf_iterator:

        out_rows = []


        # --------------------------------------------------
        # Process every hyperlink occurrence
        # --------------------------------------------------

        for _, row in pdf.iterrows():

            source_node = row["source_node"]

            source_title = row["source_title"]

            target_title = row["target_title"]

            target_reference = row["target_reference"]

            link_type = row["link_type"]

            link_uid = row["link_uid"]

            sentence = row["sentence"]


            try:

                # ------------------------------------------
                # Create LOCAL context
                # ------------------------------------------

                context = _local_context(
                    sentence=sentence,
                    target_title=target_title,
                    context_words=CONTEXT_WORDS,
                    max_full_sentence_words=MAX_FULL_SENTENCE_WORDS
                )


                # ------------------------------------------
                # Build LLM prompt
                # ------------------------------------------

                user_prompt = f"""
SOURCE ENTITY:
{source_title}

TARGET ENTITY:
<{target_title}>

LOCAL CONTEXT:
{context}

Determine the single predicate connecting the
SOURCE ENTITY and TARGET ENTITY based ONLY
on this local context.

Return exactly one record:

<{target_title}>{TUPLE_DELIM}<predicate>{TUPLE_DELIM}<description>{TUPLE_DELIM}<strength>{RECORD_DELIM}
"""


                # ------------------------------------------
                # LLM call
                # ------------------------------------------

                resp = partition_llm.invoke(
                    [
                        {
                            "role": "system",
                            "content": SYSTEM_PROMPT,
                        },
                        {
                            "role": "user",
                            "content": user_prompt,
                        },
                    ]
                )


                # ------------------------------------------
                # Parse response
                # ------------------------------------------

                predicate, description, strength = (
                    _parse_record(
                        resp.content.strip(),
                        target_title
                    )
                )


            except Exception as e:

                # ------------------------------------------
                # One bad hyperlink must NOT stop the job.
                # ------------------------------------------

                predicate = "related_to"

                description = (
                    f"[extraction failed: {e}]"
                )

                strength = 1

                context = (
                    sentence
                    if sentence
                    else ""
                )


            # ----------------------------------------------
            # Save result
            # ----------------------------------------------

            out_rows.append({

                "link_uid":
                    link_uid,

                "source_node":
                    source_node,

                "source_title":
                    source_title,

                "predicate":
                    predicate,

                "relationship_description":
                    description,

                "relationship_strength":
                    strength,

                "target_title":
                    target_title,

                "target_reference":
                    target_reference,

                "link_type":
                    link_type,

                "context_used":
                    context,

            })


        # --------------------------------------------------
        # ALWAYS yield correct schema
        # --------------------------------------------------

        yield pd.DataFrame(
            out_rows,
            columns=out_columns
        )


# ==========================================================
# 9. OUTPUT SCHEMA
# ==========================================================

TRIPLES_SCHEMA = StructType([

    StructField(
        "link_uid",
        StringType()
    ),

    StructField(
        "source_node",
        StringType()
    ),

    StructField(
        "source_title",
        StringType()
    ),

    StructField(
        "predicate",
        StringType()
    ),

    StructField(
        "relationship_description",
        StringType()
    ),

    StructField(
        "relationship_strength",
        IntegerType()
    ),

    StructField(
        "target_title",
        StringType()
    ),

    StructField(
        "target_reference",
        StringType()
    ),

    StructField(
        "link_type",
        StringType()
    ),

    StructField(
        "context_used",
        StringType()
    ),

])


