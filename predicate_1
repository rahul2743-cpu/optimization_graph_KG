    sentences_df

    .filter(
        F.col("is_resolved")
    )

    .select(
        "link_uid",
        "source_node",
        "source_title",
        "target_reference",
        "target_title",
        "link_type",
        "sentence"
    )

    .filter(
        F.col("target_title").isNotNull()
    )

)


