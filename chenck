        1,
        math.ceil(
            n_docs / DOCS_PER_CHUNK
        )
    )

    doc_batches = doc_batches.withColumn(
        "_chunk",
        F.pmod(
            F.xxhash64("source_node"),
            F.lit(n_chunks)
        )
    )

    for c in range(n_chunks):

        (
            doc_batches
            .filter(
                F.col("_chunk") == c
            )
            .drop("_chunk")
            .repartition(N_PARTITIONS)
            .mapInPandas(
                process_partition_pandas,
                schema=TRIPLES_SCHEMA
            )
            .write
            .mode("append")
            .option(
                "mergeSchema",
                "true"
            )
            .saveAsTable(
                CHECKPOINT_TABLE
            )
        )

