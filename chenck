# ==========================================================
# LLM PROCESSING
# ONE DOCUMENT -> ONE LINK -> ONE LLM CALL
# ==========================================================

def process_partition_pandas(pdf_iterator):

    import pandas as pd
    from langchain_openai import ChatOpenAI

    llm = ChatOpenAI(
        model=_CONN["model"],
        base_url=_CONN["base_url"],
        api_key=_CONN["api_key"],
        temperature=0,
        max_retries=3,
        timeout=120,
    )

    for pdf in pdf_iterator:

        results = []

        for _, row in pdf.iterrows():

            items = list(row["items"])

            contexts = _contexts_for_doc(
                row["content_with_titles"],
                items
            )

            for item, context in zip(
                items,
                contexts
            ):

                prompt = f"""
SOURCE: {row['source_title']}

TARGET: {item['target_title']}

TEXT:
{context}
"""

                try:

                    response = llm.invoke([
                        {
                            "role": "system",
                            "content": SYSTEM_PROMPT
                        },
                        {
                            "role": "user",
                            "content": prompt
                        }
                    ])

                    content = (
                        response.content
                        if isinstance(
                            response.content,
                            str
                        )
                        else str(response.content)
                    )

                    parsed = _parse_one(content)

                    if parsed is None:
                        continue

                    predicate, description, strength = parsed

                    results.append({
                        "link_uid": item["link_uid"],
                        "source_node": row["source_node"],
                        "source_title": row["source_title"],
                        "predicate": predicate,
                        "relationship_description": description,
                        "relationship_strength": strength,
                        "target_title": item["target_title"],
                        "target_reference": item["target_reference"],
                        "link_type": item["link_type"],
                        "context_used": context,
                    })

                except Exception:
                    # Failed link is NOT saved.
                    # It will be retried next run.
                    continue

        yield pd.DataFrame(
            results,
            columns=OUT_COLUMNS
        )


