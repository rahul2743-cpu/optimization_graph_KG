docs = document_rendered_df.select("source_node", "source_title").distinct()
print("documents loaded:", docs.count())

link_stats = (
    sentences_df.groupBy("source_node").agg(
        F.count("*").alias("total_links"),
        F.sum(F.col("is_resolved").cast("int")).alias("resolved_links"),
        F.sum(
            (F.col("is_resolved") & ~F.col("link_type").isin(list(IGNORE_LINK_TYPES)))
            .cast("int")
        ).alias("eligible_links"),
    )
)

saved = (
    spark.table(CHECKPOINT_TABLE)
    .groupBy("source_node")
    .agg(F.count("*").alias("saved_rows"))
)

report = (
    docs.join(link_stats, "source_node", "left")
        .join(saved, "source_node", "left")
        .fillna(0, ["total_links", "resolved_links", "eligible_links", "saved_rows"])
        .withColumn(
            "status",
            F.when(F.col("total_links") == 0, "1. no links found in document")
             .when(F.col("resolved_links") == 0, "2. links found, none resolved")
             .when(F.col("eligible_links") == 0, "3. only ignored link types (doc:wiki)")
             .when(F.col("saved_rows") == 0, "4. eligible, but LLM call failed or parse returned None")
             .when(F.col("saved_rows") < F.col("eligible_links"), "5. partially saved")
             .otherwise("ok"),
        )
)

report.groupBy("status").count().orderBy("status").show(truncate=False)
display(report.filter(F.col("status") != "ok").orderBy("status", "source_title"))
