TUPLE_DELIM = "<|>"
RECORD_DELIM = "##"


# ----------------------------------------------------------
# LLM PROMPT
# ----------------------------------------------------------

SYSTEM_PROMPT = f"""
You label ONE relationship for a knowledge graph.

SOURCE = source document.
TARGET = linked entity.
TEXT = short context around the TARGET.

The graph edge is:

SOURCE --predicate--> TARGET

Choose a specific predicate that makes this a TRUE natural statement.

Return exactly:

1{TUPLE_DELIM}PREDICATE{TUPLE_DELIM}DESCRIPTION{TUPLE_DELIM}STRENGTH{RECORD_DELIM}

Rules:

PREDICATE:
- snake_case
- 2-5 words
- specific relationship
- NEVER use related_to, mentions, references, has_link

DESCRIPTION:
- one complete sentence
- maximum 25 words

STRENGTH:
- integer 1-10
- 10 = explicit/central
- 1 = passing mention

No JSON.
No markdown.
No extra text.
"""


# ----------------------------------------------------------
# REGEX
# ----------------------------------------------------------

_UNRESOLVED_MARKUP_RE = re.compile(
    r"\[?<doc:(?:wiki:)?[^<>]+>\]?"
)

_LINK_RE = re.compile(
    r"\[(?:(?P<label>[^<>\[\]]+?)\s+)?"
    r"<doc:(?:wiki:)?[^>]+>\]"
    r"|<(?P<title>[^<>]+)>"
)

_SENTINEL_RE = re.compile(
    r"\ue000(\d+)\ue001"
)


# ----------------------------------------------------------
# HELPERS
# ----------------------------------------------------------

def _sanitize(text):
    return re.sub(
        r"\s+",
        " ",
        _UNRESOLVED_MARKUP_RE.sub(" ", text or "")
    ).strip()


def _to_snake_case(s):
    s = re.sub(
        r"[^a-z0-9]+",
        "_",
        s.strip().lower()
    )
    return re.sub(
        r"_+",
        "_",
        s
    ).strip("_") or "related_to"


def _tokenize_doc(text):

    display = []

    def repl(m):
        title = m.group("title")
        display.append(
            title if title is not None
            else (m.group("label") or "")
        )
        return f"\ue000{len(display)-1}\ue001"

    return _LINK_RE.sub(repl, text or "").split(), display


def _render(words, display, target):

    def sub(m):
        k = int(m.group(1))
        return (
            f"<{display[k]}>"
            if k == target
            else display[k]
        )

    return re.sub(
        r"\s+",
        " ",
        " ".join(
            _SENTINEL_RE.sub(sub, w)
            for w in words
        )
    ).strip()


def _fallback(sentence, title):

    s = _sanitize(sentence)
    marker = f"<{title}>"
    k = s.find(marker)

    if k < 0:
        return marker

    before = s[:k].split()[-WINDOW_WORDS:]
    after = s[k + len(marker):].split()[:WINDOW_WORDS]

    return " ".join(
        before + [marker] + after
    )


def _contexts_for_doc(doc_text, items):

    words, display = _tokenize_doc(doc_text)

    positions = {}

    for i, word in enumerate(words):
        for m in _SENTINEL_RE.finditer(word):
            positions.setdefault(
                int(m.group(1)),
                i
            )

    contexts = []

    for item in items:

        occ = item["occurrence"]
        title = item["target_title"]

        if (
            occ is None
            or occ not in positions
            or display[occ] != title
        ):
            contexts.append(
                _fallback(
                    item["sentence"],
                    title
                )
            )
            continue

        i = positions[occ]

        # ------------------------------------------------
        # FIXED WINDOW: exactly WINDOW_WORDS before/after.
        # ------------------------------------------------

        lo = max(0, i - WINDOW_WORDS)
        hi = min(len(words), i + WINDOW_WORDS + 1)

        text = _render(
            words[lo:hi],
            display,
            occ
        )

        if lo > 0:
            text = "... " + text

        if hi < len(words):
            text += " ..."

        contexts.append(text)

    return contexts


def _parse_one(text):

    parts = [
        p.strip()
        for p in text
        .split(RECORD_DELIM)[0]
        .strip()
        .split(TUPLE_DELIM)
    ]

    if len(parts) < 3:
        return None

    predicate = _to_snake_case(parts[1])

    if len(parts) >= 4:
        description = TUPLE_DELIM.join(parts[2:-1])
        strength_text = parts[-1]
    else:
        description = parts[2]
        strength_text = ""

    match = re.search(
        r"\d+",
        strength_text
    )

    strength = (
        max(
            1,
            min(10, int(match.group()))
        )
        if match
        else 5
    )

    return predicate, description, strength


