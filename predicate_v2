# ==========================================================
# 16. CHECKPOINT: RETRY FAILED DOCUMENTS, SKIP FINISHED ONES
# ==========================================================

table_exists = spark.catalog.tableExists(CHECKPOINT_TABLE)

if table_exists:

    existing_cols = spark.table(CHECKPOINT_TABLE).columns

    # Rows from the old (v1) version have no status column; their
    # failures are recognisable by the description text.
    failed_sql_parts = [
        "relationship_description LIKE '[extraction failed%'"
    ]

    if "status" in existing_cols:
        failed_sql_parts.append("status = 'failed'")

    failed_sql = " OR ".join(failed_sql_parts)

    n_failed_docs = spark.sql(
        f"SELECT COUNT(DISTINCT source_node) AS n "
        f"FROM {CHECKPOINT_TABLE} WHERE {failed_sql}"
    ).first()["n"]

    if n_failed_docs and RETRY_FAILED:

        # Delete ALL rows of documents that had a failure, so the
        # document is re-extracted cleanly (no duplicates).
        spark.sql(
            f"DELETE FROM {CHECKPOINT_TABLE} "
            f"WHERE source_node IN ("
            f"SELECT source_node FROM {CHECKPOINT_TABLE} "
            f"WHERE {failed_sql})"
        )

        print(
            f"Documents with failed rows, queued for retry : "
            f"{n_failed_docs}"
        )

    elif n_failed_docs:

        print(
            f"WARNING: {n_failed_docs} documents contain failed rows "
            f"(RETRY_FAILED=False, they will be skipped)."
        )

    already_done = (
        spark.table(CHECKPOINT_TABLE)
        .select("source_node")
        .distinct()
    )

    n_already_done = already_done.count()

    doc_prompt_inputs = doc_prompt_inputs.join(
        already_done,
        on="source_node",
        how="left_anti"
    )

    print(
        f"Already checkpointed (skipped) : "
        f"{n_already_done} documents"
    )

else:

    print(
        "No existing checkpoint table found -- "
        f"starting fresh at {CHECKPOINT_TABLE}"
    )


# ==========================================================
# 17. COUNT DOCUMENTS
# ==========================================================

n_docs_to_process = doc_prompt_inputs.count()

print(f"Documents to process this run : {n_docs_to_process}")


# ==========================================================
# 18. RUN DISTRIBUTED EXTRACTION IN CHUNKS
#
# Each chunk is written to the checkpoint table as soon as it
# finishes, so a crash only loses the chunk in progress.
# ==========================================================

if n_docs_to_process == 0:

    print("Nothing to do -- all documents already checkpointed.")

else:

    rows_before = (
        spark.table(CHECKPOINT_TABLE).count()
        if table_exists else 0
    )

    n_chunks = max(1, -(-n_docs_to_process // CHUNK_DOCS))

    # Even, stateless chunking by hash (no giant id lists collected)
    chunked_inputs = doc_prompt_inputs.withColumn(
        "_chunk_id",
        F.pmod(F.hash("source_node"), F.lit(n_chunks))
    )

    for chunk_id in range(n_chunks):

        chunk_df = (
            chunked_inputs
            .filter(F.col("_chunk_id") == chunk_id)
            .drop("_chunk_id")
        )

        (
            chunk_df
            .repartition(N_PARTITIONS)
            .mapInPandas(
                process_partition_pandas,
                schema=TRIPLES_SCHEMA
            )
            .write
            .mode("append")
            .option("mergeSchema", "true")
            .saveAsTable(CHECKPOINT_TABLE)
        )

        print(f"  chunk {chunk_id + 1}/{n_chunks} saved")

    # Count from the SAVED table -- never from the lazy DataFrame,
    # which would re-run every LLM call.
    rows_after = spark.table(CHECKPOINT_TABLE).count()

    print(
        f"Relationships extracted this run : "
        f"{rows_after - rows_before}"
    )

    print(f"Checkpointed to : {CHECKPOINT_TABLE}")


# ==========================================================
# 19. LOAD COMPLETE RESULT
# ==========================================================

if not spark.catalog.tableExists(CHECKPOINT_TABLE):

    raise RuntimeError(
        f"{CHECKPOINT_TABLE} does not exist and there was nothing "
        f"to process. Check sentences_df / document_rendered_df."
    )

triples_df = spark.table(CHECKPOINT_TABLE).cache()

n_total = triples_df.count()

print()
print(f"triples_df (all runs combined) row count : {n_total}")
