# ==========================================================
# 5. UNRESOLVED DOCUMENT MARKUP
#
# Things such as <doc:wiki:Temp_Import....> are NOT targets.
# ==========================================================

_UNRESOLVED_MARKUP_RE = re.compile(
    r"\[?<doc:(?:wiki:)?[^<>]+>\]?"
)

# Any <...> span (used to hide periods inside other hyperlinks)
_MARKUP_SPAN_RE = re.compile(r"<[^<>]*>")

# Sentence boundary: . ! ? (optionally followed by closing quote/bracket)
# followed by whitespace/end, OR a newline.
_BOUNDARY_RE = re.compile(r"[.!?][\"')\]]*(?=\s|$)|\n")

# A period after one of these does NOT end a sentence.
_ABBREVIATIONS = {
    "e.g", "i.e", "etc", "vs", "inc", "ltd", "co", "corp", "fig",
    "no", "dr", "mr", "mrs", "ms", "prof", "approx", "eq", "cf",
    "al", "sec", "vol", "ver", "rev",
}


# ==========================================================
# 6. PREDICATE ALIASES (light canonicalization)
#
# Only merges pure synonyms. Direction-changing forms such as
# is_used_by are deliberately NOT aliased.
# ==========================================================

PREDICATE_ALIASES = {
    "is_related_to": "related_to",
    "relates_to": "related_to",
    "utilizes": "uses",
    "utilises": "uses",
    "relies_on": "depends_on",
    "is_dependent_on": "depends_on",
    "refers_to": "mentions",
    "references": "mentions",
    "is_part_of": "belongs_to",
    "includes": "contains",
}


# ==========================================================
# 7. TEXT HELPERS
# ==========================================================

def _sanitize_for_llm(text):
    """Remove unresolved <doc:wiki:...> markup and normalize whitespace."""

    text = text or ""
    text = _UNRESOLVED_MARKUP_RE.sub(" ", text)
    text = re.sub(r"\s+", " ", text)

    return text.strip()


def _to_snake_case(s):
    """Convert an LLM predicate into snake_case."""

    s = (s or "").strip().lower()
    s = re.sub(r"[^a-z0-9]+", "_", s)
    s = re.sub(r"_+", "_", s)
    s = s.strip("_")

    return s or "related_to"


def _normalize_predicate(s):
    """snake_case + alias map + enforce the 5-word limit."""

    p = _to_snake_case(s)
    p = PREDICATE_ALIASES.get(p, p)

    words = p.split("_")

    if len(words) > 5:
        p = "_".join(words[:5])

    return p or "related_to"


def _response_text(resp):
    """
    Return the text of an LLM response.

    Some serving endpoints return content as a list of blocks
    (for example reasoning + text). Only text blocks are used.
    """

    content = getattr(resp, "content", resp)

    if isinstance(content, list):

        parts = []

        for block in content:

            if isinstance(block, dict):

                if block.get("type") in (None, "text"):
                    parts.append(block.get("text", "") or "")

            else:
                parts.append(str(block))

        return "".join(parts).strip()

    return str(content or "").strip()


# ==========================================================
# 8. TARGET / SENTENCE FINDING
# ==========================================================

def _target_pattern(entity_name):
    """
    Regex for the hyperlink <Entity Name>.

    Case-insensitive, allows spaces inside the brackets
    ("< MTCCM >") and any whitespace between words.
    """

    words = (entity_name or "").split()

    if not words:
        return None

    return re.compile(
        r"<\s*"
        + r"\s+".join(re.escape(w) for w in words)
        + r"\s*>",
        flags=re.IGNORECASE
    )


def _prepare_document(content):
    """
    Prepare a document ONCE (not once per target).

    Returns (text, masked):

        text   = document with unresolved <doc:...> markup removed
                 (newlines kept, so they can act as boundaries)
        masked = same text, but every <...> span is replaced by
                 'x' characters of equal length, so periods inside
                 other hyperlinks are never mistaken for sentence ends
    """

    text = _UNRESOLVED_MARKUP_RE.sub(" ", content or "")

    masked = _MARKUP_SPAN_RE.sub(
        lambda m: "x" * len(m.group(0)),
        text
    )

    return text, masked


def _is_sentence_boundary(masked, match):
    """False for periods that belong to abbreviations ('e.g.', 'Inc.', 'J.')."""

    token = match.group(0)

    if token == "\n" or token[0] != ".":
        return True

    before = masked[max(0, match.start() - 30):match.start()]
    last = re.search(r"(\S+)$", before)

    if not last:
        return True

    word = last.group(1).lower().lstrip("(['\"")

    if word in _ABBREVIATIONS:
        return False

    if len(word) == 1 and word.isalpha():
        return False

    return True


def _find_sentence_for_entity(doc, entity_name):
    """
    Find the sentence containing <Entity Name>.

    Strategy: locate the target first, then expand left/right to
    the nearest sentence boundary. Only a bounded window around the
    target is scanned, so cost does not grow with document size.
    """

    text, masked = doc

    pattern = _target_pattern(entity_name)

    if pattern is None or not text:
        return ""

    m = pattern.search(text)

    if not m:
        return ""

    # ---- left edge -------------------------------------------------
    lo = max(0, m.start() - MAX_SENTENCE_CHARS)
    start = lo

    for b in _BOUNDARY_RE.finditer(masked, lo, m.start()):

        if _is_sentence_boundary(masked, b):
            start = b.end()

    # ---- right edge ------------------------------------------------
    hi = min(len(text), m.end() + MAX_SENTENCE_CHARS)
    end = hi

    for b in _BOUNDARY_RE.finditer(masked, m.end(), hi):

        if _is_sentence_boundary(masked, b):
            end = b.end()
            break

    return _sanitize_for_llm(text[start:end])


def _extract_local_context(sentence, entity_name, window=6):
    """N words before + <Entity> + N words after."""

    pattern = _target_pattern(entity_name)

    if not sentence or pattern is None:
        return ""

    match = pattern.search(sentence)

    if not match:
        return ""

    before_words = sentence[:match.start()].split()[-window:]
    after_words = sentence[match.end():].split()[:window]

    return " ".join(before_words + [match.group(0)] + after_words)


def _window_around_target(sentence, entity_name, max_chars):
    """Cut a window that KEEPS the target (never sentence[:N])."""

    if len(sentence) <= max_chars:
        return sentence

    pattern = _target_pattern(entity_name)
    m = pattern.search(sentence) if pattern else None

    center = m.start() if m else 0

    start = max(0, center - max_chars // 2)
    end = min(len(sentence), start + max_chars)
    start = max(0, end - max_chars)

    prefix = "...[truncated] " if start > 0 else ""
    suffix = " ...[truncated]" if end < len(sentence) else ""

    return prefix + sentence[start:end] + suffix


def _build_entity_context(doc, entity_name):
    """
    For ONE target:

        prepared document -> sentence -> local context
    """

    sentence = _find_sentence_for_entity(doc, entity_name)

    local_context = _extract_local_context(
        sentence,
        entity_name,
        LOCAL_CONTEXT_WORDS
    )

    sentence = _window_around_target(
        sentence,
        entity_name,
        MAX_SENTENCE_CHARS
    )

    return sentence, local_context


# ==========================================================
# 9. PARSE ONE LLM RESPONSE
# ==========================================================

def _parse_single_record(text):
    """
    Parse ONE LLM response.

    Expected:  Entity <|> predicate <|> description <|> strength ##

    Returns (predicate, description, strength, ok).
    ok=False means the response could not be parsed.
    """

    if not text:
        return ("related_to", "[empty LLM response]", 1, False)

    record = text.split(RECORD_DELIM)[0].strip().strip(",")

    parts = [p.strip() for p in record.split(TUPLE_DELIM)]

    if len(parts) < 3:
        return (
            "related_to",
            f"[unparseable LLM response: {text[:200]}]",
            1,
            False
        )

    predicate = _normalize_predicate(parts[1])

    # Strength = last field if it holds a number; description = everything
    # in between (so a delimiter inside the description cannot corrupt it).
    strength = 5
    description_parts = parts[2:]

    if len(parts) >= 4:

        m = re.search(r"\d+", parts[-1])

        if m:
            strength = max(1, min(10, int(m.group())))
            description_parts = parts[2:-1]

    description = " ".join(p for p in description_parts if p)

    return (predicate, description, strength, True)


# ==========================================================
# 10. ONE TARGET -> ONE LLM CALL -> ONE RESULT
# ==========================================================

def _extract_one(llm, source_title, doc, target_title):
    """
    Process ONE target. Never raises.

    status:
        ok           LLM answered and the answer was parsed
        no_sentence  target hyperlink not found in the document
        parse_error  LLM answered but the format was unusable
        failed       API / network error (retried on the next run)
    """

    sentence = ""

    try:

        sentence, local_context = _build_entity_context(doc, target_title)

        if not sentence:

            return {
                "predicate": "related_to",
                "description": (
                    "[No sentence containing target hyperlink was found]"
                ),
                "strength": 1,
                "status": "no_sentence",
                "sentence": "",
            }

        user_prompt = f"""
SOURCE DOCUMENT TITLE:
{source_title}


TARGET ENTITY:
{target_title}


FULL SENTENCE CONTAINING THE TARGET:
{sentence}


FOCUSED LOCAL CONTEXT:
{local_context}


TASK:

Determine the ONE semantic relationship so that the statement

    "{source_title}"  <predicate>  "{target_title}"

is true. The SOURCE is the subject and the TARGET is the object.

Use the full sentence as the primary context.
Use the local context as additional focused context.

Return exactly ONE predicate.
"""

        resp = llm.invoke(
            [
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": user_prompt},
            ]
        )

        predicate, description, strength, ok = _parse_single_record(
            _response_text(resp)
        )

        return {
            "predicate": predicate,
            "description": description,
            "strength": strength,
            "status": "ok" if ok else "parse_error",
            "sentence": sentence,
        }

    except Exception as e:

        return {
            "predicate": "related_to",
            "description": (
                f"[extraction failed: {type(e).__name__}: {str(e)[:300]}]"
            ),
            "strength": 1,
            "status": "failed",
            "sentence": sentence,
        }


# ==========================================================
# 11. DISTRIBUTED WORKER
# ==========================================================

def process_partition_pandas(pdf_iterator):

    import pandas as pd
    from concurrent.futures import ThreadPoolExecutor
    from langchain_openai import ChatOpenAI

    partition_llm = ChatOpenAI(
        model=_CONN["model"],
        base_url=_CONN["base_url"],
        api_key=_CONN["api_key"],
        temperature=0,
        max_retries=LLM_MAX_RETRIES,
        timeout=LLM_TIMEOUT_SECONDS,
        max_tokens=LLM_MAX_TOKENS,
    )

    out_columns = [
        "source_node",
        "source_title",
        "predicate",
        "relationship_description",
        "relationship_strength",
        "target_title",
        "target_reference",
        "link_type",
        "status",
        "evidence_sentence",
    ]

    for pdf in pdf_iterator:

        # ------------------------------------------------------
        # PLAN: one unit of work per (document, target title).
        # If the same title is linked several times in a document
        # (different target_reference), the LLM is called once.
        # Each document is prepared (cleaned/masked) only once.
        # ------------------------------------------------------

        work = {}
        row_plan = []

        for _, row in pdf.iterrows():

            doc = _prepare_document(row["content_with_titles"])

            for entity in row["entities"]:

                key = (row["source_node"], entity["target_title"])

                if key not in work:
                    work[key] = (
                        row["source_title"],
                        doc,
                        entity["target_title"],
                    )

                row_plan.append((row, entity, key))

        # ------------------------------------------------------
        # EXECUTE: one LLM call per unit, in parallel threads
        # ------------------------------------------------------

        def _run(key):
            source_title, doc, target_title = work[key]
            return key, _extract_one(
                partition_llm, source_title, doc, target_title
            )

        with ThreadPoolExecutor(
            max_workers=LLM_THREADS_PER_PARTITION
        ) as pool:
            results = dict(pool.map(_run, list(work.keys())))

        # ------------------------------------------------------
        # ASSEMBLE: one RDF relationship row per target
        # ------------------------------------------------------

        out_rows = []

        for row, entity, key in row_plan:

            r = results[key]

            out_rows.append(
                {
                    # Source node is the document TITLE
                    "source_node": row["source_title"],
                    "source_title": row["source_title"],
                    "predicate": r["predicate"],
                    "relationship_description": r["description"],
                    "relationship_strength": r["strength"],
                    "target_title": entity["target_title"],
                    "target_reference": entity["target_reference"],
                    "link_type": entity["link_type"],
                    "status": r["status"],
                    "evidence_sentence": (
                        r["sentence"][:MAX_EVIDENCE_CHARS]
                    ),
                }
            )

        yield pd.DataFrame(out_rows, columns=out_columns)


