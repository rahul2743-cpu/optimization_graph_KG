# ==========================================================
# PIPELINE TRACE — per-document, stage by stage
# Shows WHERE each of your 50 documents lost its relationships:
#   Stage 1 : Cell 7  -- hyperlinks found (total, doc:Temp_Import, doc:wiki)
#   Stage 2 : Cell 10 -- relationships actually extracted (triples_df)
#   Stage 3 : Cell 12 -- final nodes/edges present in G
#
# Needs: per_source_summary (Cell 7), triples_df (Cell 10),
#        document_rendered_df (Cell 8d), G (Cell 12)
# ==========================================================
import re
import hashlib
import networkx as nx
import pandas as pd
from rdflib import Namespace, URIRef
from pyspark.sql import functions as F

print("=" * 80)
print("PIPELINE TRACE: WHY DOCUMENTS ARE MISSING / THIN")
print("=" * 80)

# ---- Stage 1: hyperlinks found per document (Cell 7) ----------------------
stage1 = (
    per_source_summary
    .select(
        "source_title",
        "hyperlink_total",
        "doc_Temp_Import_total",   # these get sent to the LLM
        "doc_wiki_total",          # these are IGNORED (IGNORE_LINK_TYPES)
    )
    .toPandas()
)

# ---- Stage 2: relationships actually extracted per document (Cell 10) -----
stage2 = (
    triples_df
    .groupBy("source_title")
    .agg(F.count("*").alias("relationships_extracted"))
    .toPandas()
)

# ---- Stage 3: recompute doc URIs and check presence/size in G (Cell 12) ---
BASE = "http://knwbt.local/kg/"
ENTITY_NS = Namespace(BASE + "entity/")

def _slugify(title: str) -> str:
    s = re.sub(r"[^\w\s-]", "", title.strip())
    s = re.sub(r"[\s-]+", "_", s)
    return s.strip("_") or "unknown"

def entity_uri(title: str, reference: str) -> str:
    short_hash = hashlib.md5(reference.encode()).hexdigest()[:8]
    return str(URIRef(ENTITY_NS[f"{_slugify(title)}_{short_hash}"]))

stage3_rows = []
for row in document_rendered_df.select("source_node", "source_title").toLocalIterator():
    uri = entity_uri(row["source_title"], row["source_node"])
    in_graph = uri in G.nodes
    if in_graph:
        descendants = nx.descendants(G, uri)
        total_nodes = len(descendants) + 1
        edges = G.subgraph({uri} | descendants).number_of_edges()
    else:
        total_nodes, edges = 0, 0
    stage3_rows.append({
        "source_title": row["source_title"],
        "in_G": in_graph,
        "G_total_nodes": total_nodes,
        "G_edges": edges,
    })
stage3 = pd.DataFrame(stage3_rows)

# ---- Merge all three stages into one trace table ---------------------------
trace = (
    stage1
    .merge(stage2, on="source_title", how="left")
    .merge(stage3, on="source_title", how="left")
)
trace["relationships_extracted"] = trace["relationships_extracted"].fillna(0).astype(int)
trace["G_total_nodes"] = trace["G_total_nodes"].fillna(0).astype(int)
trace["G_edges"] = trace["G_edges"].fillna(0).astype(int)
trace["in_G"] = trace["in_G"].fillna(False)

# ---- Diagnose WHY each document is thin/missing ----------------------------
def diagnose(r):
    if r["hyperlink_total"] == 0:
        return "No hyperlinks in document at all"
    if r["doc_Temp_Import_total"] == 0:
        return "All links are doc:wiki (IGNORED by Cell 10's IGNORE_LINK_TYPES)"
    if r["relationships_extracted"] == 0:
        return "Had doc:Temp_Import links but LLM extraction produced 0 relationships"
    if not r["in_G"]:
        return "Relationships extracted but node missing from G (RDF/Cell 12 handoff loss)"
    return "OK"

trace["likely_cause"] = trace.apply(diagnose, axis=1)

trace = trace.sort_values("G_total_nodes", ascending=False).reset_index(drop=True)

try:
    display(trace)
except NameError:
    print(trace.to_string(index=False))

# ---- Root-cause summary -----------------------------------------------------
print()
print("=" * 80)
print("ROOT CAUSE BREAKDOWN (count of documents per cause)")
print("=" * 80)
cause_counts = trace["likely_cause"].value_counts().rename_axis("Cause").reset_index(name="Doc Count")
try:
    display(cause_counts)
except NameError:
    print(cause_counts.to_string(index=False))
